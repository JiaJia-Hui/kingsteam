{% doc %}
  @prompt
    A image with text overlay slider. The text style should follow global settings. The entire area should be clickable. The widget should be mobile compatible, meaning that it needs to be coded in mobile responsive style.On mobile screens (under 750px), stack the controls vertically and ensure all buttons have a minimum touch target of 44px. Use clamp() for font sizes so they scale.The control arrows and dots should be hidable., The dots are too large in mobile mode. Make them smaller, make the dot size in mobile mode adjustable.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{%- capture black_friday_end -%}{%- render 'black-friday-end' -%}{%- endcapture -%}
{%- assign black_friday_end = black_friday_end | plus: 0 -%}
{%- assign slider_timestamp = 'now' | date: '%s' | plus: 0 -%}

{% style %}
  .ai-slider-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    overflow: hidden;
    background-color: {{ block.settings.background_color }};
  }

  .ai-slider-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .ai-slider-track-{{ ai_gen_id }} {
    display: flex;
    transition: transform 0.5s ease-in-out;
  }

  .ai-slider-track-{{ ai_gen_id }}[data-snap] {
    transition: none;
  }

  .ai-slider-slide-{{ ai_gen_id }} {
    flex: 0 0 100%;
    min-width: 0;
    position: relative;
    display: block;
    text-decoration: none;
  }

  .ai-slider-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    overflow: hidden;
  }

  .ai-slider-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  [data-artwork] .ai-slider-image-wrapper-{{ ai_gen_id }} {
    background-color: #f3e2d1;
  }

  [data-artwork] .ai-slider-image-{{ ai_gen_id }} {
    object-fit: contain;
  }

  .ai-slider-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-slider-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-slider-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }});
    pointer-events: none;
  }

  .ai-slider-content-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: {{ block.settings.text_alignment }};
    width: 90%;
    max-width: 800px;
    pointer-events: none;
    z-index: 2;
  }

  .ai-slider-heading-{{ ai_gen_id }} {
    font-family: var(--font-stack-header);
    font-weight: var(--font-weight-header--bolder);
    font-size: clamp(24px, 5vw, {{ block.settings.heading_size }}px);
    line-height: 1.2;
    color: {{ block.settings.text_color }};
    margin: 0 0 16px 0;
    letter-spacing: {{ settings.type_header_spacing }}px;
  }

  .ai-slider-subheading-{{ ai_gen_id }} {
    font-family: var(--font-stack-body);
    font-weight: var(--font-weight-body);
    font-size: clamp(14px, 3vw, {{ block.settings.subheading_size }}px);
    line-height: 1.5;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-slider-controls-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 20px;
    z-index: 3;
  }

  .ai-slider-arrow-{{ ai_gen_id }} {
    background-color: {{ block.settings.controls_color }};
    color: {{ block.settings.controls_icon_color }};
    border: none;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    flex-shrink: 0;
  }

  .ai-slider-arrow-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.controls_hover_color }};
    transform: scale(1.1);
  }

  .ai-slider-arrow-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-slider-arrow-{{ ai_gen_id }}.hidden {
    display: none;
  }

  .ai-slider-dots-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .ai-slider-dots-{{ ai_gen_id }}.hidden {
    display: none;
  }

  .ai-slider-dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.5;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: opacity 0.3s ease;
  }

  .ai-slider-dot-{{ ai_gen_id }}.active {
    opacity: 1;
    transform: scale(1.3);
  }

  .ai-slider-wrapper-{{ ai_gen_id }}:has([data-artwork]) .ai-slider-controls-{{ ai_gen_id }} {
    inset: 50% 8px auto;
    width: auto;
    transform: translateY(-50%);
    justify-content: space-between;
    pointer-events: none;
  }

  .ai-slider-controls-{{ ai_gen_id }} button {
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-slider-track-{{ ai_gen_id }} {
      transition: none;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-slider-{{ ai_gen_id }}:has([data-artwork]) .ai-slider-image-wrapper-{{ ai_gen_id }} {
      aspect-ratio: 16 / 9;
    }

    [data-artwork='black-friday'] .ai-slider-image-{{ ai_gen_id }} {
      object-fit: cover;
    }

    .ai-slider-controls-{{ ai_gen_id }} {
      left: 16px;
      right: 16px;
      top: 50%;
      bottom: auto;
      width: calc(100% - 32px);
      transform: translateY(-50%);
      justify-content: space-between;
      gap: 12px;
    }

    .ai-slider-arrow-{{ ai_gen_id }} {
      min-width: 44px;
      min-height: 44px;
      width: 44px;
      height: 44px;
    }

    .ai-slider-dot-{{ ai_gen_id }} {
      min-width: 44px;
      min-height: 44px;
      width: {{ block.settings.dot_size_mobile }}px;
      height: {{ block.settings.dot_size_mobile }}px;
    }

    .ai-slider-heading-{{ ai_gen_id }} {
      margin-bottom: 12px;
    }

    .ai-slider-content-{{ ai_gen_id }} {
      width: 85%;
    }
  }
{% endstyle %}

<image-slider-{{ ai_gen_id }}
  class="ai-slider-{{ ai_gen_id }}"
  {% if block.settings.autoplay %}data-autoplay-delay="{{ block.settings.autoplay_speed | times: 1000 }}"{% endif %}
  {{ block.shopify_attributes }}
>
  <div class="ai-slider-wrapper-{{ ai_gen_id }}">
    <div class="ai-slider-track-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign slide_image_key = 'slide_' | append: i | append: '_image'
          assign slide_heading_key = 'slide_' | append: i | append: '_heading'
          assign slide_subheading_key = 'slide_' | append: i | append: '_subheading'
          assign slide_link_key = 'slide_' | append: i | append: '_link'

          assign slide_image = block.settings[slide_image_key]
          assign slide_heading = block.settings[slide_heading_key]
          assign slide_subheading = block.settings[slide_subheading_key]
          assign slide_link = block.settings[slide_link_key]
          assign slide_asset = blank
          if i == 1 and slide_image == blank
            assign slide_asset = block.settings.slide_1_asset
          endif
          if slide_asset == 'kingsteam-black-friday-2026.jpg' and slider_timestamp >= black_friday_end
            continue
          endif
        %}

        {% if slide_asset != blank or slide_image != blank or slide_heading != blank or slide_subheading != blank %}
          <a
            href="{% if slide_link != blank %}{{ slide_link }}{% else %}#{% endif %}"
            class="ai-slider-slide-{{ ai_gen_id }}"
            {% if slide_asset == 'kingsteam-black-friday-2026.jpg' %}data-artwork="black-friday"{% elsif slide_asset != blank %}data-artwork{% endif %}
            {% if slide_link == blank %}onclick="return false;"{% endif %}
          >
            <div class="ai-slider-image-wrapper-{{ ai_gen_id }}">
              {% if slide_asset != blank %}
                <img
                  src="{{ slide_asset | asset_url }}"
                  alt="{{ block.settings.slide_1_asset_alt | escape }}"
                  loading="eager"
                  fetchpriority="high"
                  class="ai-slider-image-{{ ai_gen_id }}"
                >
              {% elsif slide_image %}
                <img
                  src="{{ slide_image | image_url: width: 2000 }}"
                  alt="{{ slide_image.alt | escape }}"
                  loading="lazy"
                  width="{{ slide_image.width }}"
                  height="{{ slide_image.height }}"
                  class="ai-slider-image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-slider-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}

              {% if block.settings.show_overlay and slide_asset == blank %}
                <div class="ai-slider-overlay-{{ ai_gen_id }}"></div>
              {% endif %}

              {% if slide_heading != blank or slide_subheading != blank %}
                <div class="ai-slider-content-{{ ai_gen_id }}">
                  {% if slide_heading != blank %}
                    <h2 class="ai-slider-heading-{{ ai_gen_id }}">{{ slide_heading }}</h2>
                  {% endif %}
                  {% if slide_subheading != blank %}
                    <p class="ai-slider-subheading-{{ ai_gen_id }}">{{ slide_subheading }}</p>
                  {% endif %}
                </div>
              {% endif %}
            </div>
          </a>
        {% endif %}
      {% endfor %}
    </div>

    <div class="ai-slider-controls-{{ ai_gen_id }}">
      <button
        type="button"
        class="ai-slider-arrow-{{ ai_gen_id }} ai-slider-prev-{{ ai_gen_id }} {% if block.settings.hide_arrows %}hidden{% endif %}"
        aria-label="Previous slide"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="ai-slider-dots-{{ ai_gen_id }} {% if block.settings.hide_dots %}hidden{% endif %}"></div>

      <button
        type="button"
        class="ai-slider-arrow-{{ ai_gen_id }} ai-slider-next-{{ ai_gen_id }} {% if block.settings.hide_arrows %}hidden{% endif %}"
        aria-label="Next slide"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </div>
</image-slider-{{ ai_gen_id }}>

<script>
  (function() {
    const tagName = 'image-slider-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;

    class ImageSlider extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('.ai-slider-track-{{ ai_gen_id }}');
        this.slides = Array.from(this.track.children);
        if (this.slides.length < 2) return;

        this.events = new AbortController();
        const options = { signal: this.events.signal };
        this.currentSlide = 0;
        this.motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
        this.autoplayDelay = Number(this.dataset.autoplayDelay);

        const cloneSlide = (slide) => {
          const clone = slide.cloneNode(true);
          clone.inert = true;
          clone.setAttribute('aria-hidden', 'true');
          return clone;
        };
        this.lastClone = cloneSlide(this.slides[this.slides.length - 1]);
        this.firstClone = cloneSlide(this.slides[0]);
        this.track.prepend(this.lastClone);
        this.track.append(this.firstClone);
        this.snapToSlide();

        const dotsContainer = this.querySelector('.ai-slider-dots-{{ ai_gen_id }}');
        dotsContainer.replaceChildren();
        this.dots = this.slides.map((_, index) => {
          const dot = document.createElement('button');
          dot.type = 'button';
          dot.classList.add('ai-slider-dot-{{ ai_gen_id }}');
          dot.setAttribute('aria-label', `Go to slide ${index + 1}`);
          dot.addEventListener('click', () => this.goToSlide(index), options);
          dotsContainer.appendChild(dot);
          return dot;
        });
        this.updateControls();

        this.querySelector('.ai-slider-prev-{{ ai_gen_id }}')
          .addEventListener('click', () => this.goToSlide(this.currentSlide - 1), options);
        this.querySelector('.ai-slider-next-{{ ai_gen_id }}')
          .addEventListener('click', () => this.goToSlide(this.currentSlide + 1), options);

        this.addEventListener('focusin', () => this.scheduleAutoplay(), options);
        this.addEventListener('focusout', () => queueMicrotask(() => this.scheduleAutoplay()), options);
        document.addEventListener('visibilitychange', () => this.scheduleAutoplay(), options);
        this.track.addEventListener('transitionend', (event) => {
          if (event.target === this.track && event.propertyName === 'transform' && this.wrapTimer) {
            this.snapToSlide();
          }
        }, options);

        let touchStart;
        this.addEventListener('touchstart', (event) => {
          touchStart = event.touches.length === 1 ? event.touches[0] : null;
        }, { ...options, passive: true });
        this.addEventListener('touchend', (event) => {
          if (!touchStart) return;
          const touchEnd = event.changedTouches[0];
          const dx = touchEnd.clientX - touchStart.clientX;
          const dy = touchEnd.clientY - touchStart.clientY;
          touchStart = null;
          if (Math.abs(dx) > Math.max(50, Math.abs(dy))) {
            this.goToSlide(this.currentSlide - Math.sign(dx));
          }
        }, { ...options, passive: true });
        this.addEventListener('touchcancel', () => { touchStart = null; }, options);

        this.scheduleAutoplay();
      }

      goToSlide(index) {
        if (this.wrapTimer) this.snapToSlide();

        const count = this.slides.length;
        this.currentSlide = (index + count) % count;
        this.updateControls();

        if (this.motionPreference.matches) {
          this.snapToSlide();
        } else {
          this.track.style.transform = `translateX(${-100 * (index + 1)}%)`;
          // On either boundary, move by one slide using the adjacent clone.
          if (index < 0 || index >= count) {
            this.wrapTimer = setTimeout(() => this.snapToSlide(), 550);
          }
        }
        this.scheduleAutoplay();
      }

      snapToSlide() {
        clearTimeout(this.wrapTimer);
        this.wrapTimer = null;
        this.track.setAttribute('data-snap', '');
        this.track.style.transform = `translateX(${-100 * (this.currentSlide + 1)}%)`;
        void this.track.offsetWidth;
        this.track.removeAttribute('data-snap');
      }

      updateControls() {
        this.slides.forEach((slide, index) => {
          const active = index === this.currentSlide;
          slide.inert = !active;
          this.dots[index].classList.toggle('active', active);
          this.dots[index].setAttribute('aria-current', active ? 'true' : 'false');
        });
      }

      scheduleAutoplay() {
        clearTimeout(this.autoplayTimer);
        if (!this.isConnected || !this.autoplayDelay || document.hidden || this.querySelector(':focus-visible')) return;

        this.autoplayTimer = setTimeout(() => this.goToSlide(this.currentSlide + 1), this.autoplayDelay);
      }

      disconnectedCallback() {
        this.events?.abort();
        clearTimeout(this.autoplayTimer);
        clearTimeout(this.wrapTimer);
        this.wrapTimer = null;
        this.lastClone?.remove();
        this.firstClone?.remove();
      }
    }

    customElements.define(tagName, ImageSlider);
  })();
</script>

