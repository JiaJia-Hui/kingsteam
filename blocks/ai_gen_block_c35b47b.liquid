{% doc %}
  @prompt
    A holographic product card slider. The slider should be mobile compatible, meaning that it should be responsive and adapt to mobile layout. The product cards should be swipable on mobile, each swipe flips exactly ONE product card. Give more customizable parameters.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-holo-slider-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    overflow: hidden;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background: {{ block.settings.background_color }};
  }

  .ai-holo-slider__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 clamp(8px, 1.2vw, 20px);
  }

  .ai-holo-slider__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-holo-slider__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0 0 10px;
  }

  .ai-holo-slider__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
  }

  .ai-holo-slider__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    user-select: none;
    will-change: transform;
  }

  .ai-holo-slider__viewport-{{ ai_gen_id }} {
    --edge-fade: clamp(16px, 6vw, 92px);
    overflow: hidden;
    overflow: clip;
    cursor: grab;
    touch-action: pan-y pinch-zoom;
    user-select: none;
    padding: 6px 0;
  }

  .ai-holo-slider-{{ ai_gen_id }}[data-carousel-ready] .ai-holo-slider__viewport-{{ ai_gen_id }} {
    mask-image: linear-gradient(to right, transparent, #000 var(--edge-fade), #000 calc(100% - var(--edge-fade)), transparent);
  }

  .ai-holo-slider__viewport-{{ ai_gen_id }}.is-dragging {
    cursor: grabbing;
  }

  .ai-holo-card-{{ ai_gen_id }} {
    box-sizing: border-box;
    min-width: 0;
    flex: 0 0 calc((100% - ({{ block.settings.cards_per_row_desktop | minus: 1 }} * {{ block.settings.card_gap }}px)) / {{ block.settings.cards_per_row_desktop }});
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    background: {{ block.settings.card_background }};
    scale: var(--card-scale, 1);
  }

  .ai-holo-card__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 76%;
    aspect-ratio: 100 / {{ block.settings.image_aspect_ratio }};
    margin: clamp(10px, 1.6vw, {{ block.settings.card_padding }}px) auto 0;
    overflow: hidden;
    background: {{ block.settings.image_placeholder_bg }};
  }

  .ai-holo-card__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }

  .ai-holo-card__image-main-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-holo-card__image-hover-{{ ai_gen_id }} {
    opacity: 0;
  }

  .ai-holo-card-{{ ai_gen_id }}:hover .ai-holo-card__image-{{ ai_gen_id }} {
    transform: scale({{ block.settings.image_hover_scale }});
  }

  .ai-holo-card-{{ ai_gen_id }}:hover .ai-holo-card__image-main-{{ ai_gen_id }}:has(+ .ai-holo-card__image-hover-{{ ai_gen_id }}) {
    opacity: 0;
  }

  .ai-holo-card-{{ ai_gen_id }}:hover .ai-holo-card__image-hover-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-holo-card__badge-{{ ai_gen_id }} {
    position: absolute;
    bottom: {{ block.settings.badge_position_top }}px;
    left: {{ block.settings.badge_position_left }}px;
    background: {{ block.settings.badge_background }};
    color: {{ block.settings.badge_text_color }};
    padding: 3px 7px;
    border-radius: {{ block.settings.badge_border_radius }}px;
    font-size: {{ block.settings.badge_font_size }}px;
    font-weight: 600;
    z-index: 3;
    pointer-events: none;
  }

  .ai-holo-card__content-{{ ai_gen_id }} {
    padding: clamp(12px, 1.6vw, {{ block.settings.card_padding }}px);
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
  }

  .ai-holo-card__vendor-{{ ai_gen_id }} {
    font-size: {{ block.settings.vendor_font_size }}px;
    color: {{ block.settings.vendor_color }};
    margin: 0 0 8px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-holo-card__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 6px;
    font-weight: 500;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: {{ block.settings.title_line_clamp }};
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .ai-holo-card__price-{{ ai_gen_id }} {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 8px;
  }

  .ai-holo-card__link-{{ ai_gen_id }} {
    color: inherit;
    text-decoration: none;
  }

  .ai-holo-card__link-{{ ai_gen_id }}[data-card-link]::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .ai-holo-card-{{ ai_gen_id }}:focus-within {
    outline: 2px solid currentColor;
    outline-offset: -2px;
  }

  .ai-holo-card__price-{{ ai_gen_id }}:has(+ .ai-holo-card__button-{{ ai_gen_id }}) {
    margin-bottom: 12px;
  }

  .ai-holo-card__price-current-{{ ai_gen_id }} {
    font-size: {{ block.settings.price_font_size }}px;
    color: {{ block.settings.price_color }};
    font-weight: 700;
  }

  .ai-holo-card__price-compare-{{ ai_gen_id }} {
    font-size: {{ block.settings.compare_price_font_size }}px;
    color: {{ block.settings.compare_price_color }};
    text-decoration: line-through;
  }

  .ai-holo-card__button-{{ ai_gen_id }} {
    width: 100%;
    margin-top: auto;
    padding: {{ block.settings.button_padding }}px;
    background: {{ block.settings.button_background }};
    color: {{ block.settings.button_text_color }};
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-block;
    text-align: center;
  }

  .ai-holo-card__button-{{ ai_gen_id }}:hover {
    background: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
    transform: translateY(-2px);
  }

  .ai-holo-slider__nav-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin-top: {{ block.settings.nav_spacing }}px;
  }

  .ai-holo-slider__arrow-{{ ai_gen_id }} {
    width: {{ block.settings.arrow_size }}px;
    height: {{ block.settings.arrow_size }}px;
    background: {{ block.settings.arrow_background }};
    color: {{ block.settings.arrow_color }};
    border: none;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .ai-holo-slider__arrow-{{ ai_gen_id }}:hover {
    background: {{ block.settings.arrow_hover_background }};
    color: {{ block.settings.arrow_hover_color }};
    transform: scale(1.1);
  }

  .ai-holo-slider__arrow-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-holo-slider__playback-{{ ai_gen_id }} {
    padding: 8px 14px;
    border: 1px solid currentColor;
    border-radius: 999px;
    background: transparent;
    color: {{ block.settings.heading_color }};
    font: inherit;
    cursor: pointer;
  }

  .ai-holo-slider__nav-{{ ai_gen_id }}[hidden] {
    display: none;
  }

  .ai-holo-slider__dots-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .ai-holo-slider__dot-{{ ai_gen_id }} {
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: 50%;
    background: {{ block.settings.dot_color }};
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .ai-holo-slider__dot-{{ ai_gen_id }}.active {
    background: {{ block.settings.dot_active_color }};
    transform: scale(1.2);
  }

  .ai-holo-card__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-holo-card__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  @media screen and (max-width: 989px) {
    .ai-holo-card-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - ({{ block.settings.cards_per_row_tablet | minus: 1 }} * {{ block.settings.card_gap }}px)) / {{ block.settings.cards_per_row_tablet }});
    }

    .ai-holo-slider__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-holo-slider__viewport-{{ ai_gen_id }} {
      --edge-fade: 17px;
    }

    .ai-holo-card-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - ({{ block.settings.cards_per_row_mobile | minus: 1 }} * {{ block.settings.card_gap }}px)) / {{ block.settings.cards_per_row_mobile }});
    }

    .ai-holo-slider__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-holo-slider-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.6 }}px 0 {{ block.settings.section_padding_bottom | times: 0.6 }}px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-holo-card-{{ ai_gen_id }} {
      scale: 1;
    }

    .ai-holo-card__image-{{ ai_gen_id }} {
      transition: none;
    }
  }
{% endstyle %}

<holographic-slider-{{ ai_gen_id }} class="ai-holo-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-holo-slider__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank or block.settings.subheading != blank %}
      <div class="ai-holo-slider__header-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-holo-slider__title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
        {% endif %}
        {% if block.settings.subheading != blank %}
          <p class="ai-holo-slider__subtitle-{{ ai_gen_id }}">{{ block.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-holo-slider__viewport-{{ ai_gen_id }}" data-viewport>
      <div class="ai-holo-slider__track-{{ ai_gen_id }}" data-track>
        {% if block.settings.products != blank %}
          {% for product in block.settings.products %}
          {% liquid
            assign hover_image = blank

            for image in product.images
              if image.id != product.featured_image.id
                assign hover_image = image
                break
              endif
            endfor
          %}
          <div class="ai-holo-card-{{ ai_gen_id }}">
            <div class="ai-holo-card__image-wrapper-{{ ai_gen_id }}">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  class="ai-holo-card__image-{{ ai_gen_id }} ai-holo-card__image-main-{{ ai_gen_id }}"
                  loading="lazy"
                  width="600"
                  height="{{ 600 | times: block.settings.image_aspect_ratio | divided_by: 100 }}"
                >
                {% if hover_image != blank %}
                  <img
                    src="{{ hover_image | image_url: width: 600 }}"
                    alt=""
                    class="ai-holo-card__image-{{ ai_gen_id }} ai-holo-card__image-hover-{{ ai_gen_id }}"
                    loading="lazy"
                    width="600"
                    height="{{ 600 | times: block.settings.image_aspect_ratio | divided_by: 100 }}"
                  >
                {% endif %}
              {% else %}
                <div class="ai-holo-card__placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              {% endif %}

              {% if block.settings.show_badge and product.available == false %}
                <div class="ai-holo-card__badge-{{ ai_gen_id }}">{{ block.settings.sold_out_text }}</div>
              {% elsif block.settings.show_badge and product.compare_at_price > product.price %}
                <div class="ai-holo-card__badge-{{ ai_gen_id }}">{{ block.settings.sale_text }}</div>
              {% endif %}
            </div>

            <div class="ai-holo-card__content-{{ ai_gen_id }}">
              {% if block.settings.show_vendor and product.vendor != blank %}
                <p class="ai-holo-card__vendor-{{ ai_gen_id }}">{{ product.vendor }}</p>
              {% endif %}

              <h3 class="ai-holo-card__title-{{ ai_gen_id }}">
                <a href="{{ product.url }}" class="ai-holo-card__link-{{ ai_gen_id }}"{% unless block.settings.show_button %} data-card-link{% endunless %}>
                  {{ product.title }}
                </a>
              </h3>

              {% if block.settings.show_price %}
                <div class="ai-holo-card__price-{{ ai_gen_id }}">
                  <span class="ai-holo-card__price-current-{{ ai_gen_id }}">
                    {%- assign slider_price = product.price | money -%}
                    {%- if product.price_varies -%}
                      {{ 'products.product.from_text_html' | t: price: slider_price }}
                    {%- else -%}
                      {{ slider_price }}
                    {%- endif -%}
                  </span>
                  {% if product.compare_at_price > product.price %}
                    <span class="ai-holo-card__price-compare-{{ ai_gen_id }}">
                      {{ product.compare_at_price | money }}
                    </span>
                  {% endif %}
                </div>
              {% endif %}

              {% if block.settings.show_button %}
                <a href="{{ product.url }}" class="ai-holo-card__button-{{ ai_gen_id }}">
                  {{ block.settings.button_text }}
                </a>
              {% endif %}
            </div>
            </div>
          {% endfor %}
        {% else %}
          {% for i in (1..6) %}
            <div class="ai-holo-card-{{ ai_gen_id }}">
              <div class="ai-holo-card__image-wrapper-{{ ai_gen_id }}">
                <div class="ai-holo-card__placeholder-{{ ai_gen_id }}">
                  {{ 'product-1' | placeholder_svg_tag }}
                </div>
              </div>
              <div class="ai-holo-card__content-{{ ai_gen_id }}">
                <h3 class="ai-holo-card__title-{{ ai_gen_id }}">Product {{ i }}</h3>
                <div class="ai-holo-card__price-{{ ai_gen_id }}">
                  <span class="ai-holo-card__price-current-{{ ai_gen_id }}">$99.00</span>
                </div>
                {% if block.settings.show_button %}
                  <a href="#" class="ai-holo-card__button-{{ ai_gen_id }}">{{ block.settings.button_text }}</a>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        {% endif %}
      </div>
    </div>

    <div class="ai-holo-slider__nav-{{ ai_gen_id }}" data-nav{% unless block.settings.show_navigation %} hidden{% endunless %}>
      <button type="button" class="ai-holo-slider__playback-{{ ai_gen_id }}" data-playback hidden>
        Pause scrolling
      </button>
      {% if block.settings.show_navigation %}
        <button type="button" class="ai-holo-slider__arrow-{{ ai_gen_id }}" data-prev aria-label="Previous">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        {% if block.settings.show_dots %}
          <div class="ai-holo-slider__dots-{{ ai_gen_id }}" data-dots></div>
        {% endif %}

        <button type="button" class="ai-holo-slider__arrow-{{ ai_gen_id }}" data-next aria-label="Next">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      {% endif %}
    </div>
  </div>
</holographic-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class HolographicSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.activePointerId = null;
        this.isDragging = false;
        this.suppressClick = false;
        this.wheelDelta = 0;
        this.wheelNavigated = false;
        this.wheelTimer = null;
        this.startX = 0;
        this.startY = 0;
        this.dragTranslate = 0;
        this.prevTranslate = 0;
        this.cardsPerView = 1;
        this.cloneCount = 0;
        this.playbackFrame = null;
        this.snapFrame = null;
        this.resumeTimer = null;
        this.isInView = false;
        this.isHovered = false;
        this.advancePlayback = this.advancePlayback.bind(this);
      }

      connectedCallback() {
        this.viewport = this.querySelector('[data-viewport]');
        this.track = this.querySelector('[data-track]');
        this.prevBtn = this.querySelector('[data-prev]');
        this.nextBtn = this.querySelector('[data-next]');
        this.dotsContainer = this.querySelector('[data-dots]');
        this.nav = this.querySelector('[data-nav]');
        this.playbackButton = this.querySelector('[data-playback]');

        if (!this.track) return;
        this.originalCards = Array.from(this.track.children)
          .filter((card) => !card.hasAttribute('data-clone'))
          .map((card) => card.cloneNode(true));
        if (this.originalCards.length === 0) return;

        this.motionPreference = window.matchMedia('(prefers-reduced-motion: reduce)');
        this.playbackPaused = this.motionPreference.matches;
        this.setupSlider();
        this.setupEventListeners();
      }

      getCardsPerView() {
        const width = window.innerWidth;
        if (width <= 749) return {{ block.settings.cards_per_row_mobile }};
        if (width <= 989) return {{ block.settings.cards_per_row_tablet }};
        return {{ block.settings.cards_per_row_desktop }};
      }

      setupEventListeners() {
        this.eventController = new AbortController();
        const options = { signal: this.eventController.signal };
        this.prevBtn?.addEventListener('click', () => this.moveBy(-1), options);
        this.nextBtn?.addEventListener('click', () => this.moveBy(1), options);

        this.viewport.addEventListener('pointerdown', (event) => this.handlePointerDown(event), options);
        this.viewport.addEventListener('pointermove', (event) => this.handlePointerMove(event), options);
        this.viewport.addEventListener('pointerup', (event) => this.handlePointerUp(event), options);
        this.viewport.addEventListener('pointercancel', (event) => this.handlePointerCancel(event), options);
        this.viewport.addEventListener('lostpointercapture', (event) => this.handlePointerCancel(event), options);
        this.viewport.addEventListener('pointerenter', (event) => {
          if (event.pointerType === 'mouse') {
            this.isHovered = true;
            this.syncPlayback();
          }
        }, options);
        this.viewport.addEventListener('pointerleave', (event) => {
          this.handlePointerCancel(event);
          if (event.pointerType === 'mouse') {
            this.isHovered = false;
            this.syncPlayback();
          }
        }, options);
        this.viewport.addEventListener('wheel', (event) => this.handleWheel(event), { ...options, passive: false });
        this.viewport.addEventListener('dragstart', (event) => event.preventDefault(), options);

        this.playbackButton.addEventListener('click', () => {
          this.playbackPaused = !this.playbackPaused;
          this.updatePlaybackButton();
          this.syncPlayback();
        }, options);
        this.motionPreference.addEventListener('change', (event) => {
          this.playbackPaused = event.matches;
          this.updatePlaybackButton();
          this.syncPlayback();
        }, options);
        this.addEventListener('focusin', (event) => {
          this.syncPlayback();
          const card = event.target.closest('.ai-holo-card-{{ ai_gen_id }}');
          if (!card || !event.target.matches(':focus-visible')) return;
          this.currentIndex = this.cards.indexOf(card);
          this.updatePosition(false);
          this.updateDots();
        }, options);
        this.addEventListener('focusout', () => queueMicrotask(() => this.syncPlayback()), options);
        this.track.addEventListener('click', (event) => this.handleTrackClick(event), { ...options, capture: true });
        window.addEventListener('resize', () => this.handleResize(), options);
        document.addEventListener('visibilitychange', () => this.syncPlayback(), options);

        this.visibilityObserver = new IntersectionObserver(([entry]) => {
          this.isInView = entry.isIntersecting;
          this.syncPlayback();
        });
        this.visibilityObserver.observe(this.viewport);
        this.resizeObserver = new ResizeObserver(() => this.handleResize());
        this.resizeObserver.observe(this.viewport);
      }

      setupSlider(preserveIndex = 0) {
        this.cardsPerView = this.getCardsPerView();
        this.cloneCount = this.originalCards.length > 1 ? Math.min(this.cardsPerView, this.originalCards.length) : 0;
        this.track.innerHTML = '';

        const leadingCards = this.originalCards.slice(this.originalCards.length - this.cloneCount)
          .map((card) => this.createCardClone(card));
        const mainCards = this.originalCards.map((card) => card.cloneNode(true));
        const trailingCards = this.originalCards.slice(0, this.cloneCount).map((card) => this.createCardClone(card));

        [...leadingCards, ...mainCards, ...trailingCards].forEach((card) => this.track.appendChild(card));

        this.cards = Array.from(this.track.children);
        this.viewportWidth = this.viewport.clientWidth;
        const width = parseFloat(window.getComputedStyle(this.cards[this.cloneCount]).width);
        this.step = width + this.getCardGap();
        this.centerOffset = (this.track.getBoundingClientRect().width - width) / 2;
        this.currentIndex = this.cloneCount + Math.min(preserveIndex, this.originalCards.length - 1);
        this.toggleAttribute('data-carousel-ready', this.originalCards.length > 1);
        if (this.prevBtn) this.prevBtn.disabled = this.originalCards.length < 2;
        if (this.nextBtn) this.nextBtn.disabled = this.originalCards.length < 2;
        this.createDots();
        this.updatePosition(false);
        this.updateDots();
        this.updatePlaybackButton();
      }

      updatePlaybackButton() {
        this.playbackButton.hidden = this.originalCards.length <= this.cardsPerView;
        this.playbackButton.textContent = this.playbackPaused ? 'Play scrolling' : 'Pause scrolling';
        this.nav.hidden = this.playbackButton.hidden && !this.prevBtn;
      }

      syncPlayback() {
        const focused = document.activeElement;
        const keyboardFocus = focused !== this.playbackButton && this.contains(focused) && focused.matches(':focus-visible');
        if (!this.isConnected || !this.isInView || document.hidden || this.playbackButton.hidden ||
            this.playbackPaused || this.isHovered || keyboardFocus || this.activePointerId !== null ||
            this.resumeTimer !== null) {
          this.stopPlayback();
          return;
        }
        if (this.playbackFrame !== null || this.snapFrame !== null || !this.step) return;

        this.lastFrameTime = null;
        this.playbackFrame = window.requestAnimationFrame(this.advancePlayback);
      }

      advancePlayback(timestamp) {
        if (this.lastFrameTime !== null) {
          const elapsed = Math.min(timestamp - this.lastFrameTime, 50);
          const distanceInCards = elapsed * 0.035 / this.step;
          const loopLength = this.originalCards.length;
          const positionInLoop = this.playbackIndex - this.cloneCount + distanceInCards;
          this.playbackIndex = this.cloneCount + ((positionInLoop % loopLength + loopLength) % loopLength);
          this.renderPosition(this.getTranslateForIndex(this.playbackIndex));
          const index = Math.round(this.playbackIndex);
          if (this.currentIndex !== index) {
            this.currentIndex = index;
            this.updateDots();
          }
        }
        this.lastFrameTime = timestamp;
        this.playbackFrame = window.requestAnimationFrame(this.advancePlayback);
      }

      stopPlayback() {
        window.cancelAnimationFrame(this.playbackFrame);
        this.playbackFrame = null;
      }

      deferPlayback() {
        this.stopPlayback();
        window.clearTimeout(this.resumeTimer);
        this.resumeTimer = window.setTimeout(() => {
          this.resumeTimer = null;
          this.syncPlayback();
        }, 700);
      }

      createCardClone(card) {
        const clone = card.cloneNode(true);
        clone.dataset.clone = 'true';
        clone.setAttribute('aria-hidden', 'true');
        clone.querySelectorAll('a').forEach((link) => { link.tabIndex = -1; });
        return clone;
      }

      getCardGap() {
        const trackStyles = window.getComputedStyle(this.track);
        return parseFloat(trackStyles.columnGap || trackStyles.gap || 0);
      }

      getTranslateForIndex(index) {
        return this.centerOffset - this.step * index;
      }

      renderPosition(translate) {
        this.trackTranslate = translate;
        this.track.style.transform = `translate3d(${translate}px, 0, 0)`;
        this.playbackIndex = this.step ? (this.centerOffset - translate) / this.step : this.currentIndex;
        const falloff = (this.cardsPerView + 1) / 2;
        this.cards.forEach((card, index) => {
          const proximity = Math.max(0, 1 - Math.abs(index - this.playbackIndex) / falloff);
          const scale = (0.84 + 0.16 * proximity * proximity * (3 - 2 * proximity)).toFixed(3);
          if (card.style.getPropertyValue('--card-scale') !== scale) {
            card.style.setProperty('--card-scale', scale);
          }
        });
      }

      getRealIndex() {
        if (this.originalCards.length === 0) return 0;
        let realIndex = (this.currentIndex - this.cloneCount) % this.originalCards.length;
        if (realIndex < 0) realIndex += this.originalCards.length;
        return realIndex;
      }

      createDots() {
        if (!this.dotsContainer) return;
        this.dotsContainer.innerHTML = '';
        for (let i = 0; i < this.originalCards.length; i++) {
          const dot = document.createElement('button');
          dot.className = 'ai-holo-slider__dot-{{ ai_gen_id }}';
          dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
          dot.addEventListener('click', () => this.goToSlide(i));
          this.dotsContainer.appendChild(dot);
        }
      }

      updateDots() {
        if (!this.dotsContainer) return;
        const activeIndex = this.getRealIndex();
        const dots = this.dotsContainer.querySelectorAll('.ai-holo-slider__dot-{{ ai_gen_id }}');
        dots.forEach((dot, index) => {
          dot.classList.toggle('active', index === activeIndex);
        });
      }

      updatePosition(animate = true) {
        this.stopSnap();
        const targetTranslate = this.getTranslateForIndex(this.currentIndex);
        const finish = () => {
          this.snapFrame = null;
          this.currentIndex = this.cloneCount + this.getRealIndex();
          this.renderPosition(this.getTranslateForIndex(this.currentIndex));
          this.updateDots();
        };
        const startTranslate = this.trackTranslate;
        if (!animate || this.motionPreference.matches || startTranslate === undefined ||
            Math.abs(targetTranslate - startTranslate) < 0.1) {
          finish();
          return;
        }
        const startTime = performance.now();
        const step = (timestamp) => {
          const progress = Math.min(1, (timestamp - startTime) / 450);
          const eased = 1 - (1 - progress) ** 3;
          this.renderPosition(startTranslate + (targetTranslate - startTranslate) * eased);
          if (progress < 1) {
            this.snapFrame = window.requestAnimationFrame(step);
          } else {
            finish();
          }
        };
        this.snapFrame = window.requestAnimationFrame(step);
      }

      stopSnap() {
        window.cancelAnimationFrame(this.snapFrame);
        this.snapFrame = null;
      }

      handlePointerDown(event) {
        if (this.originalCards.length < 2 || !event.isPrimary || event.button !== 0 || this.activePointerId !== null) return;
        if (event.target.closest('button, input, select, textarea, label')) return;
        this.activePointerId = event.pointerId;
        this.suppressClick = false;
        this.startX = event.clientX;
        this.startY = event.clientY;
        this.stopPlayback();
      }

      handlePointerMove(event) {
        if (event.pointerId !== this.activePointerId) return;
        const delta = event.clientX - this.startX;
        if (!this.isDragging) {
          const verticalDelta = Math.abs(event.clientY - this.startY);
          if (verticalDelta > 6 && verticalDelta >= Math.abs(delta)) {
            this.activePointerId = null;
            this.deferPlayback();
            return;
          }
          if (Math.abs(delta) <= 6) return;
          this.isDragging = true;
          this.stopSnap();
          this.currentIndex = Math.round(this.playbackIndex);
          this.prevTranslate = this.trackTranslate;
          this.viewport.classList.add('is-dragging');
          if (event.pointerType !== 'touch') this.viewport.setPointerCapture(event.pointerId);
        }
        // Leave room for the snap transition to finish when dragging a full card width.
        const dragLimit = this.step * 0.95;
        const drag = this.prevTranslate + Math.max(-dragLimit, Math.min(dragLimit, delta));
        const first = this.getTranslateForIndex(this.cloneCount - 1);
        const last = this.getTranslateForIndex(this.cloneCount + this.originalCards.length);
        this.dragTranslate = Math.max(last + 1, Math.min(first - 1, drag));
        this.renderPosition(this.dragTranslate);
      }

      handlePointerUp(event) {
        if (event.pointerId !== this.activePointerId) return;
        this.activePointerId = null;
        this.deferPlayback();
        if (!this.isDragging) return;
        const movedBy = this.dragTranslate - this.prevTranslate;
        const delta = Math.abs(movedBy) > this.step / 5 ? -Math.sign(movedBy) : 0;
        this.isDragging = false;
        this.viewport.classList.remove('is-dragging');
        // Pointer capture is released by the browser after pointerup.
        this.suppressClick = true;
        this.moveBy(delta);
      }

      handlePointerCancel(event) {
        if (event.pointerId !== this.activePointerId) return;
        this.activePointerId = null;
        this.deferPlayback();
        if (!this.isDragging) return;
        this.isDragging = false;
        this.viewport.classList.remove('is-dragging');
        this.updatePosition(true);
      }

      handleTrackClick(event) {
        if (this.suppressClick && event.detail > 0) {
          event.preventDefault();
          event.stopPropagation();
        }
      }

      handleWheel(event) {
        if (event.ctrlKey || this.isDragging || this.originalCards.length < 2) return;
        const horizontalDelta = event.deltaX || (event.shiftKey ? event.deltaY : 0);
        const verticalDelta = event.shiftKey && !event.deltaX ? 0 : event.deltaY;
        if (Math.abs(horizontalDelta) <= Math.abs(verticalDelta)) return;
        event.preventDefault();

        window.clearTimeout(this.wheelTimer);
        this.wheelTimer = window.setTimeout(() => {
          this.wheelDelta = 0;
          this.wheelNavigated = false;
        }, 120);
        if (this.wheelNavigated) return;

        if (Math.sign(horizontalDelta) !== Math.sign(this.wheelDelta)) this.wheelDelta = 0;
        this.wheelDelta += horizontalDelta;
        if (event.deltaMode === 0 && Math.abs(this.wheelDelta) < 24) return;
        this.wheelNavigated = true;
        this.moveBy(Math.sign(this.wheelDelta));
      }

      handleResize() {
        if (this.viewport.clientWidth === this.viewportWidth && this.getCardsPerView() === this.cardsPerView) return;
        this.stopPlayback();
        const realIndex = this.getRealIndex();
        this.setupSlider(realIndex);
        this.syncPlayback();
      }

      moveBy(delta) {
        if (this.originalCards.length < 2) return;
        this.deferPlayback();
        const first = this.cloneCount - 1;
        const last = this.cloneCount + this.originalCards.length;
        this.currentIndex = Math.max(first, Math.min(last, this.currentIndex + delta));
        this.updatePosition(true);
        this.updateDots();
      }

      goToSlide(index) {
        this.moveBy(this.cloneCount + index - this.currentIndex);
      }

      disconnectedCallback() {
        this.eventController?.abort();
        this.visibilityObserver?.disconnect();
        this.resizeObserver?.disconnect();
        this.stopPlayback();
        this.stopSnap();
        window.clearTimeout(this.resumeTimer);
        window.clearTimeout(this.wheelTimer);
        this.resumeTimer = null;
        this.wheelDelta = 0;
        this.wheelNavigated = false;
        this.activePointerId = null;
        this.isDragging = false;
        this.isHovered = false;
        this.isInView = false;
      }
    }

    customElements.define('holographic-slider-{{ ai_gen_id }}', HolographicSlider{{ ai_gen_id }});
  })();
</script>

