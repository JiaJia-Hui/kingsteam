<a class="ks-m-card" href="{{ prod.url }}">
  <div class="ks-m-thumb">
    {%- if prod.compare_at_price > prod.price -%}
      <span class="ks-m-badge">Sale</span>
    {%- endif -%}
    {%- if prod.featured_image -%}
      <img
        src="{{ prod.featured_image | image_url: width: 400 }}"
        alt="{{ prod.featured_image.alt | default: prod.title | escape }}"
        width="190" height="190" loading="lazy">
    {%- endif -%}
  </div>
  <p class="ks-m-name">{{ prod.title }}</p>
  <p class="ks-m-price">
    <b>{{ prod.price | money }}</b>
    {%- if prod.compare_at_price > prod.price -%}
      <s>{{ prod.compare_at_price | money }}</s>
    {%- endif -%}
  </p>
</a>
