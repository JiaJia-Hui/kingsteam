{% comment %}
  Renders a swatch input component.
  Accepts:
  - id: {String} unique input id
  - type: {String} input type. Accepts 'radio' or 'checkbox', defaults to 'radio' (optional)
  - name: {String} input name,
  - value: {ProductOptionValueDrop} input value
  - swatch: {SwatchDrop} the swatch drop
  - product_form_id: {String} id of the form associted with the input
  - checked: {Boolean} default checked status
  - disabled: {Boolean} default disabled status (optional)
  - visually_disabled: {Boolean} style the swatch as disabled, but leave the input enabled (optional)
  - help_text: {String} additional content to render inside the label (optional)

  Usage:
   {% render 'swatch-input',
      id: input_id,
      name: input_name,
      value: input_value,
      swatch: swatch,
      product_form_id: product_form_id,
      checked: checked
    %}
{% endcomment %}
{%- liquid
  assign swatch_value = null
  assign swatch_focal_point = null

  if swatch.image
    assign image_url = swatch.image | image_url: width: 80
    assign swatch_value = 'url(' | append: image_url | append: ')'
    assign swatch_focal_point = swatch.image.presentation.focal_point
  elsif swatch.color
    assign swatch_value = 'rgb(' | append: swatch.color.rgb | append: ')'
  else
    assign value_downcase = value | downcase | strip
    assign product_colors = settings.product_colors | split: ','
    for product_color in product_colors
      assign parts = product_color | strip | split: ':'
      assign name = parts.first | downcase | strip
      assign color = parts.last | strip
      if name == value_downcase
        assign swatch_value = color
        break
      endif
    endfor

    if swatch_value == blank
      case value_downcase
        when 'purple blue'
          assign swatch_value = 'linear-gradient(135deg, #b19cd9 50%, #8db4d2 50%)'
        when 'gray pink', 'grey pink'
          assign swatch_value = 'linear-gradient(135deg, #a5a5a5 50%, #ffd1dc 50%)'
        else
          assign color_name = value_downcase | remove: ' ' | remove: '-'
          assign hex_color = color_name | color_to_hex
          assign hex_prefix = hex_color | slice: 0, 1
          if hex_prefix == '#'
            assign swatch_value = hex_color
          elsif value.variant.featured_image
            assign image_url = value.variant.featured_image | image_url: width: 80
            assign swatch_value = 'url(' | append: image_url | append: ')'
          endif
      endcase
    endif
  endif
-%}
<div class="m-product-option--swatch">
  <input
    type="{{ type | default: 'radio' }}"
    id="{{ id }}"
    name="{{ name }}"
    value="{{ value | escape }}"
    form="{{ product_form_id }}"
    class="m-product-option__input{% if visually_disabled %} disabled{% endif %}"
    {% if checked %}
      checked
    {% endif %}
    {% if disabled %}
      disabled
    {% endif %}
    {% if additional_props %}
      {{ additional_props }}
    {% endif %}
  >
  <label
    for="{{ id }}"
    class="m-product-option--node__label relative"
    data-swatch-type="shopify_swatch"
    data-option-type="swatch_color"
    style="--swatch-background: {{ swatch_value | default: '#f3f1ec' | escape }};{% if swatch_focal_point %} --swatch-focal-point: {{ swatch_focal_point | escape }};{% endif %}"
  >
    {{ help_text }}
    {%- if swatch_value == blank -%}
      <span class="m-swatch-fallback" aria-hidden="true">{{ value | slice: 0, 2 | upcase | escape }}</span>
    {%- endif -%}
  </label>
</div>
<span class="m-tooltip__content">{{- value -}}</span>
