{%- liquid
  assign groups = 'ALL PRODUCTS|BEST SELLERS|HAIR TOOLS|HAIR CARE|HOME&ACCESSORY|DISCOVER' | split: '|'
  assign curl_quiz_label = section.settings.discover_curl_quiz_label | default: 'Hair Curl Quiz'
  assign curl_quiz_url = section.settings.discover_curl_quiz_url | default: '/pages/hair-curl-quiz'
  assign blog_label = section.settings.discover_blog_label | default: 'Blog Sharing'
  assign blog_url = section.settings.discover_blog_url | default: '/blogs/news'
  assign experience_label = section.settings.discover_experience_label | default: 'User Experience Sharing'
  assign experience_url = section.settings.discover_experience_url | default: '/pages/user-experience-sharing'
-%}

{% if mobile %}
  <nav class="ks-shop-nav-mobile" aria-label="Main navigation">
{% else %}
  <kingsteam-shop-nav>
    <nav class="ks-shop-nav" aria-label="Main navigation">
{% endif %}
  <ul class="ks-shop-nav__items">
    {% for group in groups %}
      {% if forloop.first %}
        <li class="ks-shop-nav__item"><a class="ks-shop-nav__trigger" href="{% render 'all-products-url' %}">{{ group }}</a></li>
        {% continue %}
      {% endif %}
      {% liquid
        assign category_handle = group | handleize
        assign feature_handles = ''
        assign feature_labels = ''
        assign group_label = group
        case group
          when 'BEST SELLERS'
            assign group_label = 'Best Sellers'
            assign feature_labels = 'Care Ritual Kit|2-in-1 Hair & Facial Steamer|Facial Steamer' | split: '|'
          when 'HAIR TOOLS'
            assign group_label = 'Hair Tools'
            assign feature_handles = 'hooded-hair-dryer|stand-ionic-hair-dryer|oil-care-straightener' | split: '|'
          when 'HAIR CARE'
            assign group_label = 'Hair Care'
          when 'HOME&ACCESSORY'
            assign category_handle = 'home-accessory'
            assign group_label = 'Home & Accessories'
            assign feature_labels = 'Cordless Beard Straightener|Automatic Hairbrush Cleaner|Portable Steam Cleaner' | split: '|'
          when 'DISCOVER'
            assign group_label = 'Discover'
        endcase
        capture handles
          render 'kingsteam-category-products', category: category_handle
        endcapture
        assign handles = handles | split: '|'
        if group == 'BEST SELLERS' or group == 'HOME&ACCESSORY'
          assign feature_handles = handles | slice: 0, 3
        endif
        assign category_url = ''
        unless group == 'DISCOVER'
          assign category_url = pages[category_handle].url
        endunless
        assign panel_id = section.id | append: '-shop-nav-' | append: forloop.index
      %}
      {% capture links %}
        {% if group == 'HAIR CARE' %}
          <p class="ks-shop-nav__coming">COMING SOON</p>
        {% else %}
          <ul class="ks-shop-nav__links">
            {% if group == 'DISCOVER' %}
              <li><a href="{{ curl_quiz_url }}"><span>{{ curl_quiz_label | escape }}</span>{% unless mobile %}<small>Find your curl type.</small>{% endunless %}</a></li>
              <li><a href="{{ blog_url }}"><span>{{ blog_label | escape }}</span>{% unless mobile %}<small>Browse the KingSteam blog.</small>{% endunless %}</a></li>
              <li><a href="{{ experience_url }}"><span>{{ experience_label | escape }}</span>{% unless mobile %}<small>Hear from KingSteam customers.</small>{% endunless %}</a></li>
            {% else %}
              {% for handle in handles %}
                {% assign item = all_products[handle] %}
                {% if item != blank %}
                  <li><a href="{{ item.url }}">{{ item.title | escape }}</a></li>
                {% endif %}
              {% endfor %}
            {% endif %}
          </ul>
        {% endif %}
      {% endcapture %}
      <li class="ks-shop-nav__item{% if category_url != blank %} ks-shop-nav__item--linked{% endif %}">
        {% if category_url != blank %}
          <a class="ks-shop-nav__trigger ks-shop-nav__category-link" href="{{ category_url }}"{% if request.path == category_url %} aria-current="page"{% endif %}>{{ group | escape }}</a>
        {% endif %}
        {% if mobile %}
          <details>
            {% if category_url != blank %}
              <summary class="ks-shop-nav__trigger ks-shop-nav__disclosure" aria-label="Toggle {{ group_label | escape }} submenu"></summary>
            {% else %}
              <summary class="ks-shop-nav__trigger">{{ group | escape }}</summary>
            {% endif %}
            {{ links }}
          </details>
        {% else %}
          {% if category_url != blank %}
            <button type="button" class="ks-shop-nav__trigger ks-shop-nav__disclosure" aria-label="Toggle {{ group_label | escape }} submenu" aria-expanded="false" aria-controls="{{ panel_id }}"></button>
          {% else %}
            <button type="button" class="ks-shop-nav__trigger" aria-expanded="false" aria-controls="{{ panel_id }}">{{ group | escape }}</button>
          {% endif %}
          <div id="{{ panel_id }}" class="ks-shop-nav__panel" hidden>
            <div class="ks-shop-nav__panel-inner{% if feature_handles != blank %} ks-shop-nav__panel-inner--featured{% elsif group == 'DISCOVER' %} ks-shop-nav__panel-inner--discover{% endif %}">
              <div class="ks-shop-nav__directory">
                <p class="ks-shop-nav__heading">{{ group_label | escape }}</p>
                {% unless group == 'DISCOVER' %}{{ links }}{% endunless %}
              </div>
              {% if feature_handles != blank %}
                <ul class="ks-shop-nav__cards" aria-label="Featured products">
                  {% for feature_handle in feature_handles %}
                    {% assign featured = all_products[feature_handle] %}
                    {% if featured.featured_image != blank %}
                      {% assign label = feature_labels[forloop.index0] | default: featured.title %}
                      <li>
                        <a class="ks-shop-nav__feature" href="{{ featured.url }}">
                          <span class="ks-shop-nav__feature-image">
                            {{ featured.featured_image | image_url: width: 640 | image_tag: widths: '240, 360, 520, 640', sizes: '(min-width: 1450px) 292px, 20vw', loading: 'lazy', alt: '' }}
                          </span>
                          <span class="ks-shop-nav__feature-label">{{ label | escape }}</span>
                        </a>
                      </li>
                    {% endif %}
                  {% endfor %}
                </ul>
              {% elsif group == 'DISCOVER' %}
                {{ links }}
              {% endif %}
            </div>
          </div>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
  </nav>
{% unless mobile %}</kingsteam-shop-nav>{% endunless %}
