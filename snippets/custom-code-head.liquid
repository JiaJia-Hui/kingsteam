{%- comment -%}
  Custom code before </head>
  For example: tracking code, custom css, custom javascript
  All custom code in this file will be kept when updating the theme
{%- endcomment -%}

<link rel="preload" as="image" href="{{ 'curla-poster.webp' | asset_url }}">
<style>
  html[data-curla-starting] shopify-chat:not([data-curla-docked]) {
    visibility: hidden !important;
    opacity: 0 !important;
  }
</style>
<script>
  (() => {
    const root = document.documentElement;
    root.setAttribute('data-curla-starting', '');
    // Give the native chat button back if Curla or Inbox cannot finish loading.
    window.setTimeout(() => root.removeAttribute('data-curla-starting'), 10000);
  })();
</script>
