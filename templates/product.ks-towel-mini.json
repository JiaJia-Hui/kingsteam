        "eyebrow": "Small space, warm ritual",
        "heading": "Make room for a moment of warmth.",
        "intro": "A compact, portable towel steamer for facials, grooming and spa-inspired routines at home or in the salon.",
        "accent": "#5a7d7d",
        "background": "#edf4f2",
        "hero_image_id": "75346752078170",
        "hero_image_position": 4
      },
      "blocks": {
