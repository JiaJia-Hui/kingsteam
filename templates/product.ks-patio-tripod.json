            "image_position": 5
          }
        },
        "faq1": {
          "type": "faq",
          "settings": {
            "question": "Before switching on",
            "answer": "Remove the foam protective pad from the heating tube before turning on the heater. Leaving it in place can cause overheating, melting, smoke or fire."
          }
        },
        "faq2": {
          "type": "faq",
          "settings": {
            "question": "How can I install it?",
            "answer": "Use the included adjustable tripod, or follow the manual for wall or ceiling mounting. Always follow the stated clearances and electrical instructions."
