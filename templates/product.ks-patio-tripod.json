            "image_position": 2
          }
        },
        "feature2": {
          "type": "feature",
          "settings": {
            "heading": "Warmth directed where you sit.",
            "text": "Carbon infrared heating delivers warmth directly to people and nearby objects. Choose a suitable heating setting and follow the installation clearances in the manual.",
            "image_id": "75346208457050",
            "image_position": 3
          }
        },
        "feature3": {
          "type": "feature",
          "settings": {
            "heading": "Thoughtful protection, built in.",
            "text": "A protective metal grille, grounded plug and tip-over shutoff support everyday operation. Before first use, remove the foam protective pad from the heating tube.",
