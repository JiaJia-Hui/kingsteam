            "image_position": 3
          }
        },
        "feature2": {
          "type": "feature",
          "settings": {
            "heading": "Straightforward controls.",
            "text": "The front panel pairs a timer dial with separate upper and lower lamp switches. Use only the settings and cycle instructions specified for this model.",
