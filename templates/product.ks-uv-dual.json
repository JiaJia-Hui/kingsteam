            "image_position": 4
          }
        },
        "feature3": {
          "type": "feature",
          "settings": {
            "heading": "Plan your countertop space.",
            "text": "The dimension image shows approximately 14.6 inches wide, 8.3 inches deep and 10.2 inches high. Leave the ventilation and operating clearances required in the manual.",
            "image_id": "75347221971290",
            "image_position": 6
          }
        },
        "faq1": {
          "type": "faq",
          "settings": {
            "question": "Which items can I place inside?",
            "answer": "Use only clean, dry items whose materials are compatible with the manufacturer’s UV and ozone instructions. Do not assume suitability for every tool or household item."
          }
        },
        "faq2": {
          "type": "faq",
          "settings": {
            "question": "What should I know before a cycle?",
            "answer": "Read all UV and ozone operating instructions first. Keep the cabinet closed during operation, avoid direct UV exposure and follow the manual’s ventilation guidance. This page makes no clinical sterilization claim."
          }
        }
