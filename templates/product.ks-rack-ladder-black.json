            "image_position": 6
          }
        },
        "faq1": {
          "type": "faq",
          "settings": {
            "question": "How quickly does it warm up?",
            "answer": "The product description lists around 10–15 minutes. The warmth of a towel depends on towel thickness, coverage, room conditions and your selected setting."
