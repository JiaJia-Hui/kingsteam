            "image_position": 3
          }
        },
        "feature2": {
          "type": "feature",
          "settings": {
            "heading": "Two ways to fit your space.",
            "text": "Choose plug-in convenience or a professionally installed hardwired connection. The uploaded dimension image shows approximately 31.5 × 19.5 × 4.3 inches.",
