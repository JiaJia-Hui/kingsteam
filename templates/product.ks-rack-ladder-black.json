        "feature1": {
          "type": "feature",
          "settings": {
            "heading": "Your warmth, on your schedule.",
            "text": "The integrated LED control shows your settings clearly. Adjust the temperature from 115°F to 155°F and set the built-in timer from 1 to 9 hours.",
