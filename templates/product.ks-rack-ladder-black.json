            "image_position": 5
          }
        },
        "feature3": {
          "type": "feature",
          "settings": {
            "heading": "Designed for everyday spaces.",
            "text": "The wall-mounted ladder format works in bathrooms, spas and salon settings. Follow the manual’s mounting, electrical and placement instructions for your space.",
