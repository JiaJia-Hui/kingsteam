          }
        },
        "fact4": {
          "type": "fact",
          "settings": {
            "value": "Door interlock",
            "label": "Stops when opened"
          }
        },
        "feature1": {
          "type": "feature",
          "settings": {
            "heading": "Simple timing. Considered access.",
            "text": "Choose a cycle from 5 to 60 minutes as directed in the manual. A side-opening door opens beyond 90°, and the built-in safety interlock stops operation when the door is opened.",
            "image_id": "75347314868570",
            "image_position": 4
          }
        },
        "feature2": {
          "type": "feature",
          "settings": {
            "heading": "A dedicated UVC and ozone routine.",
            "text": "The cabinet combines UVC light and ozone support within a reflective stainless-steel interior. Check item compatibility and follow the manufacturer’s operating and ventilation instructions.",
            "image_id": "75347314835802",
            "image_position": 3
          }
        },
        "feature3": {
          "type": "feature",
          "settings": {
            "heading": "A practical addition to your workstation.",
            "text": "Two removable trays help separate compatible tools and accessories. Clean and dry tools before loading, leave space between items and avoid overcrowding.",
            "image_id": "75347314770266",
            "image_position": 1
          }
        },
        "faq1": {
          "type": "faq",
          "settings": {
            "question": "How should I prepare tools?",
            "answer": "Clean and dry compatible tools before loading. Arrange them with space between items, and follow the product instructions for cycle selection and maintenance."
          }
        },
        "faq2": {
          "type": "faq",
          "settings": {
            "question": "How do I care for the cabinet?",
            "answer": "Follow the manual for cleaning the stainless-steel interior and trays, replacing the UVC lamp and using the unit safely. Avoid direct UV exposure and observe all ozone ventilation instructions."
          }
        }
      },
