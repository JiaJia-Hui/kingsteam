      "type": "ks-product-story",
      "settings": {
        "eyebrow": "Care for the tools of your craft",
        "heading": "An orderly station starts with a thoughtful routine.",
        "intro": "A 12L cabinet with two removable trays, simple timer controls and easy access for compatible nail and beauty tools.",
        "accent": "#4e6080",
        "background": "#f0f2f6",
        "hero_image_id": "75347314803034",
        "hero_image_position": 2
      },
