            "image_position": 4
          }
        },
        "feature2": {
          "type": "feature",
          "settings": {
            "heading": "Designed with protective details.",
            "text": "The product lists overheat protection and a 9.84-foot anti-chew cord. Route and secure the cable according to the instructions; protective features do not replace proper installation.",
