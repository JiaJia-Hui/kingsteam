            "image_position": 5
          }
        },
        "feature3": {
          "type": "feature",
          "settings": {
            "heading": "A compact, wall-mounted format.",
            "text": "The uploaded image shows an approximately 8.5 × 7.4-inch body. Follow the manual for mounting clearances, bedding separation and electrical connection. ECO mode cycles heating as needed.",
