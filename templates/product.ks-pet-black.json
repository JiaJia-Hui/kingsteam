            "image_position": 6
          }
        },
        "faq1": {
          "type": "faq",
          "settings": {
            "question": "Which spaces is it listed for?",
            "answer": "The listing describes use in dog houses, kennels and chicken coops. Check the manual for approved shelter conditions and choose temperature settings suitable for the animal."
