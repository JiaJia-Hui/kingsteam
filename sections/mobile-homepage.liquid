        {
          "type": "text",
          "id": "author",
          "label": "客户姓名",
          "default": "Alesha S."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Mobile Homepage",
      "blocks": [
        { "type": "hero" },
        { "type": "trust_bar" },
        { "type": "product_scroller" },
        { "type": "category_grid" },
        { "type": "banner" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
