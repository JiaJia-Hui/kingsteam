{{ 'mobile-homepage.css' | asset_url | stylesheet_tag }}

<div class="ks-mobile-home" id="shopify-section-{{ section.id }}">
  {%- for block in section.blocks -%}

    {%- case block.type -%}

    {%- when 'hero' -%}
      {%- assign has_image = false -%}
      {%- if block.settings.image != blank -%}{%- assign has_image = true -%}{%- endif -%}
      <section
        class="ks-m-hero{% if has_image %} ks-m-hero--img{% endif %}"
        {{ block.shopify_attributes }}
      >
        {%- if has_image -%}
          <img
            class="ks-m-hero-bg"
            src="{{ block.settings.image | image_url: width: 800 }}"
            alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
            width="800"
            height="480"
            loading="eager"
          >
          <div class="ks-m-hero-overlay"></div>
        {%- endif -%}
        <div class="ks-m-hero-content">
          {%- if block.settings.eyebrow != blank -%}
            <span class="ks-m-eyebrow">{{ block.settings.eyebrow }}</span>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h1>{{ block.settings.heading }}</h1>
          {%- endif -%}
          {%- if block.settings.description != blank -%}
            <p class="ks-m-hero-desc">{{ block.settings.description }}</p>
          {%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <a class="ks-m-btn-dark" href="{{ block.settings.button_link | default: '/collections/all' }}">
              {{ block.settings.button_label }}
            </a>
          {%- endif -%}
        </div>
      </section>

    {%- when 'trust_bar' -%}
      <div class="ks-m-trust" {{ block.shopify_attributes }}>
        <div>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="2" y="6" width="13" height="11" rx="1"/>
            <path d="M15 9h4l3 3v5h-7"/>
            <circle cx="6" cy="18" r="2"/>
            <circle cx="18" cy="18" r="2"/>
          </svg>
          <p>{{ block.settings.item_1 | default: 'Free $60+' }}</p>
        </div>
        <div>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 3l8 3v6c0 5-3.5 7.5-8 9-4.5-1.5-8-4-8-9V6l8-3z"/>
            <path d="M9 12l2 2 4-4"/>
          </svg>
          <p>{{ block.settings.item_2 | default: 'Prop 65 safe' }}</p>
        </div>
        <div>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 3c4 5 6 8 6 11a6 6 0 0 1-12 0c0-3 2-6 6-11z"/>
          </svg>
          <p>{{ block.settings.item_3 | default: 'Ozone steam' }}</p>
        </div>
      </div>

    {%- when 'product_scroller' -%}
      <div class="ks-m-section" {{ block.shopify_attributes }}>
        <div class="ks-m-section-head">
          <h2>{{ block.settings.heading | default: 'Best sellers' }}</h2>
          {%- if block.settings.link_label != blank -%}
            <a href="{{ block.settings.link_url | default: '/collections/all' }}">
              {{ block.settings.link_label }} &rarr;
            </a>
          {%- endif -%}
        </div>
      </div>
      <div class="ks-m-scroller">
        {%- assign product_handles = block.settings.product_1 | append: ',' | append: block.settings.product_2 | append: ',' | append: block.settings.product_3 | append: ',' | append: block.settings.product_4 | split: ',' -%}
        {%- for handle in product_handles -%}
          {%- if handle != blank -%}
            {%- assign prod = all_products[handle] -%}
            {%- if prod != blank -%}
              <a class="ks-m-card" href="{{ prod.url }}">
                <div class="ks-m-thumb">
                  {%- if prod.compare_at_price > prod.price -%}
                    <span class="ks-m-badge">Sale</span>
                  {%- endif -%}
                  {%- if prod.featured_image -%}
                    <img
                      src="{{ prod.featured_image | image_url: width: 320 }}"
                      alt="{{ prod.featured_image.alt | default: prod.title | escape }}"
                      width="160" height="160"
                      loading="lazy"
                    >
                  {%- endif -%}
                </div>
                <p class="ks-m-name">{{ prod.title }}</p>
                <p class="ks-m-price">
                  <b>{{ prod.price | money }}</b>
                  {%- if prod.compare_at_price > prod.price -%}
                    <s>{{ prod.compare_at_price | money }}</s>
                  {%- endif -%}
                </p>
              </a>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>

    {%- when 'category_grid' -%}
      <div class="ks-m-cats" {{ block.shopify_attributes }}>
        {%- if block.settings.heading != blank -%}
          <h2 class="ks-m-section-title">{{ block.settings.heading }}</h2>
        {%- endif -%}
        <div class="ks-m-cat-grid">
          {%- comment -%} Category 1 {%- endcomment -%}
          <a class="ks-m-cat" href="{{ block.settings.cat_1_link | default: '/collections/hair-tools' }}">
            {%- if block.settings.cat_1_image != blank -%}
              <img
                src="{{ block.settings.cat_1_image | image_url: width: 400 }}"
                alt="{{ block.settings.cat_1_image.alt | default: block.settings.cat_1_title | escape }}"
                width="200" height="130"
                loading="lazy"
              >
            {%- else -%}
              {%- assign col1 = collections['hair-tools'] -%}
              {%- if col1.image -%}
                <img src="{{ col1.image | image_url: width: 400 }}" alt="{{ col1.title }}" width="200" height="130" loading="lazy">
              {%- elsif col1.products.first.featured_image -%}
                <img src="{{ col1.products.first.featured_image | image_url: width: 400 }}" alt="{{ col1.title }}" width="200" height="130" loading="lazy">
              {%- endif -%}
            {%- endif -%}
            <span>{{ block.settings.cat_1_title | default: 'Hair Tools' }}</span>
          </a>
          {%- comment -%} Category 2 {%- endcomment -%}
          <a class="ks-m-cat" href="{{ block.settings.cat_2_link | default: '/collections/hair-care' }}">
            {%- if block.settings.cat_2_image != blank -%}
              <img
                src="{{ block.settings.cat_2_image | image_url: width: 400 }}"
                alt="{{ block.settings.cat_2_image.alt | default: block.settings.cat_2_title | escape }}"
                width="200" height="130"
                loading="lazy"
              >
            {%- else -%}
              {%- assign col2 = collections['hair-care'] -%}
              {%- if col2.image -%}
                <img src="{{ col2.image | image_url: width: 400 }}" alt="{{ col2.title }}" width="200" height="130" loading="lazy">
              {%- elsif col2.products.first.featured_image -%}
                <img src="{{ col2.products.first.featured_image | image_url: width: 400 }}" alt="{{ col2.title }}" width="200" height="130" loading="lazy">
              {%- endif -%}
            {%- endif -%}
            <span>{{ block.settings.cat_2_title | default: 'Beauty Tools' }}</span>
          </a>
        </div>
      </div>

    {%- when 'banner' -%}
      <div class="ks-m-banner" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <img
            src="{{ block.settings.image | image_url: width: 800 }}"
            alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
            width="800" height="250"
            loading="lazy"
          >
        {%- endif -%}
        <div class="ks-m-overlay">
          {%- if block.settings.heading != blank -%}
            <h2>{{ block.settings.heading }}</h2>
          {%- endif -%}
          {%- if block.settings.description != blank -%}
            <p>{{ block.settings.description }}</p>
          {%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <a class="ks-m-btn-light" href="{{ block.settings.button_link }}">
              {{ block.settings.button_label }}
            </a>
          {%- endif -%}
        </div>
      </div>

    {%- when 'review' -%}
      <div class="ks-m-reviews" {{ block.shopify_attributes }}>
        {%- if block.settings.eyebrow != blank -%}
          <span class="ks-m-eyebrow">{{ block.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if block.settings.heading != blank -%}
          <h2>{{ block.settings.heading }}</h2>
        {%- endif -%}
        <div class="ks-m-quote">
          <div class="ks-m-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          {%- if block.settings.quote != blank -%}
            <p class="ks-m-quote-text">&ldquo;{{ block.settings.quote }}&rdquo;</p>
          {%- endif -%}
          {%- if block.settings.author != blank -%}
            <p class="ks-m-quote-who">&mdash; {{ block.settings.author }}</p>
          {%- endif -%}
        </div>
        <div class="ks-m-dots">
          <span class="ks-m-dot active"></span>
          <span class="ks-m-dot"></span>
          <span class="ks-m-dot"></span>
        </div>
      </div>

    {%- endcase -%}
  {%- endfor -%}
</div><!-- /.ks-mobile-home -->

{% schema %}
{
  "name": "Mobile Homepage",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "hero",
      "name": "Hero 顶部区域",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Banner 图片（不上传则显示纯色背景）"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "小标题",
          "default": "CARE BEGINS WITH STEAM"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "主标题",
          "default": "Steam. Hydrate. Transcend."
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "描述文字",
          "default": "Professional facial & hair steamers for the at-home spa."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "按钮文字",
          "default": "Shop best sellers"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "按钮链接"
        }
      ]
    },
    {
      "type": "trust_bar",
      "name": "信任标语栏",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "item_1",
          "label": "标语 1",
          "default": "Free $60+"
        },
        {
          "type": "text",
          "id": "item_2",
          "label": "标语 2",
          "default": "Prop 65 safe"
        },
        {
          "type": "text",
          "id": "item_3",
          "label": "标语 3",
          "default": "Ozone steam"
        }
      ]
    },
    {
      "type": "product_scroller",
      "name": "Best Sellers 产品横滑",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "标题",
          "default": "Best sellers"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "右侧链接文字",
          "default": "Shop all"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "右侧链接地址"
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "产品 1"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "产品 2"
        },
        {
          "type": "product",
          "id": "product_3",
          "label": "产品 3"
        },
        {
          "type": "product",
          "id": "product_4",
          "label": "产品 4"
        }
      ]
    },
    {
      "type": "category_grid",
      "name": "分类图片网格",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "标题",
          "default": "Shop by category"
        },
        {
          "type": "header",
          "content": "分类 1"
        },
        {
          "type": "image_picker",
          "id": "cat_1_image",
          "label": "分类 1 图片"
        },
        {
          "type": "text",
          "id": "cat_1_title",
          "label": "分类 1 名称",
          "default": "Hair Tools"
        },
        {
          "type": "url",
          "id": "cat_1_link",
          "label": "分类 1 链接"
        },
        {
          "type": "header",
          "content": "分类 2"
        },
        {
          "type": "image_picker",
          "id": "cat_2_image",
          "label": "分类 2 图片"
        },
        {
          "type": "text",
          "id": "cat_2_title",
          "label": "分类 2 名称",
          "default": "Beauty Tools"
        },
        {
          "type": "url",
          "id": "cat_2_link",
          "label": "分类 2 链接"
        }
      ]
    },
    {
      "type": "banner",
      "name": "全宽 Banner",
      "limit": 2,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Banner 图片"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "标题",
          "default": "2 in 1 Hair & Facial Steamer"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "描述文字",
          "default": "Deep nourishment and a radiant glow — one device."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "按钮文字",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "按钮链接"
        }
      ]
    },
    {
      "type": "review",
      "name": "客户评价",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
