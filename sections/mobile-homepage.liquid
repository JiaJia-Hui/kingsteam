{{ 'mobile-homepage.css' | asset_url | stylesheet_tag }}

<div class="ks-mobile-home">
  {%- for block in section.blocks -%}
    {%- case block.type -%}

    {%- comment -%}══════════ HERO ══════════{%- endcomment -%}
    {%- when 'hero' -%}
      {%- assign has_img = false -%}
      {%- if block.settings.image != blank -%}{%- assign has_img = true -%}{%- endif -%}
      {%- assign opa = block.settings.overlay_opacity | times: 0.01 -%}
      <section
        class="ks-m-hero{% if has_img %} ks-m-hero--img{% endif %}"
        style="
          --h-bg:      {{ block.settings.bg_color }};
          --h-ey:      {{ block.settings.eyebrow_color }};
          --h-head:    {{ block.settings.heading_color }};
          --h-desc:    {{ block.settings.desc_color }};
          --h-btn-bg:  {{ block.settings.btn_bg }};
          --h-btn-txt: {{ block.settings.btn_text }};
          --h-opa:     {{ opa }};
        "
        {{ block.shopify_attributes }}
      >
        {%- if has_img -%}
          <img class="ks-m-hero-bg"
               src="{{ block.settings.image | image_url: width: 800 }}"
               alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
               loading="eager" width="800" height="480">
          <div class="ks-m-hero-overlay"></div>
        {%- endif -%}
        <div class="ks-m-hero-inner">
          {%- if block.settings.eyebrow != blank -%}
            <span class="ks-m-eyebrow">{{ block.settings.eyebrow }}</span>
          {%- endif -%}
          {%- if block.settings.heading != blank -%}
            <h1>{{ block.settings.heading }}</h1>
          {%- endif -%}
          {%- if block.settings.description != blank -%}
            <p class="ks-m-hero-desc">{{ block.settings.description }}</p>
          {%- endif -%}
          {%- if block.settings.btn_label != blank -%}
            <a class="ks-m-btn" href="{{ block.settings.btn_link | default: '/collections/all' }}">
              {{ block.settings.btn_label }}
            </a>
          {%- endif -%}
        </div>
      </section>

    {%- comment -%}══════════ TRUST BAR ══════════{%- endcomment -%}
    {%- when 'trust_bar' -%}
      <div
        class="ks-m-trust"
        style="
          --t-bg:     {{ block.settings.bg_color }};
          --t-border: {{ block.settings.border_color }};
          --t-icon:   {{ block.settings.icon_color }};
          --t-text:   {{ block.settings.text_color }};
        "
        {{ block.shopify_attributes }}
      >
        <div>
          <svg viewBox="0 0 24 24"><rect x="2" y="6" width="13" height="11" rx="1"/><path d="M15 9h4l3 3v5h-7"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg>
          <p>{{ block.settings.item_1 }}</p>
        </div>
        <div>
          <svg viewBox="0 0 24 24"><path d="M12 3l8 3v6c0 5-3.5 7.5-8 9-4.5-1.5-8-4-8-9V6l8-3z"/><path d="M9 12l2 2 4-4"/></svg>
          <p>{{ block.settings.item_2 }}</p>
        </div>
        <div>
          <svg viewBox="0 0 24 24"><path d="M12 3c4 5 6 8 6 11a6 6 0 0 1-12 0c0-3 2-6 6-11z"/></svg>
          <p>{{ block.settings.item_3 }}</p>
        </div>
      </div>

    {%- comment -%}══════════ PRODUCT SCROLLER ══════════{%- endcomment -%}
    {%- when 'product_scroller' -%}
      {%- assign show_n = block.settings.products_to_show | default: 50 -%}
      {%- comment -%}
        FIX: block.settings.collection IS already a collection object in Shopify Liquid.
        Do NOT wrap with collections[...] — that converts the object to a string and returns nil.
        Use block.settings.collection.products directly.
        Fallback: iterate all store collections to guarantee products always show.
      {%- endcomment -%}
      {%- assign ps_col = block.settings.collection -%}

      <div
        class="ks-m-ps-wrap"
        style="
          --ps-head:   {{ block.settings.heading_color }};
          --ps-link:   {{ block.settings.link_color }};
          --ps-card:   {{ block.settings.card_bg }};
          --ps-badge:  {{ block.settings.badge_bg }};
          --ps-name:   {{ block.settings.name_color }};
          --ps-price:  {{ block.settings.price_color }};
        "
        {{ block.shopify_attributes }}
      >
        <div class="ks-m-section-head">
          <h2>{{ block.settings.heading }}</h2>
          {%- if block.settings.link_label != blank -%}
            <a href="{{ block.settings.link_url | default: '/collections/all' }}">{{ block.settings.link_label }} &rarr;</a>
          {%- endif -%}
        </div>
        <div class="ks-m-scroller">

          {%- if ps_col != blank -%}
            {%- comment -%} Collection is selected: use it directly {%- endcomment -%}
            {%- for prod in ps_col.products limit: show_n -%}
              {%- render 'ks-product-card', prod: prod -%}
            {%- endfor -%}
          {%- else -%}
            {%- comment -%} No collection set: pull from all collections, deduplicated {%- endcomment -%}
            {%- assign seen = '' -%}
            {%- for col in collections -%}
              {%- for prod in col.products limit: 20 -%}
                {%- unless seen contains prod.handle -%}
                  {%- assign seen = seen | append: prod.handle | append: ',' -%}
                  {%- render 'ks-product-card', prod: prod -%}
                {%- endunless -%}
              {%- endfor -%}
            {%- endfor -%}
          {%- endif -%}

        </div>
      </div>

    {%- comment -%}══════════ CATEGORY GRID ══════════{%- endcomment -%}
    {%- when 'category_grid' -%}
      {%- assign c1_opa = block.settings.overlay_opacity | times: 0.01 -%}
      <div
        class="ks-m-cats"
        style="
          --cg-head:    {{ block.settings.heading_color }};
          --cg-opa:     {{ c1_opa }};
          --cg-overlay: {{ block.settings.overlay_color }};
          --cg-label:   {{ block.settings.label_color }};
        "
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.heading != blank -%}
          <h2 class="ks-m-section-title">{{ block.settings.heading }}</h2>
        {%- endif -%}
        <div class="ks-m-cat-grid">
          <a class="ks-m-cat" href="{{ block.settings.cat_1_link | default: '/collections/hair-tools' }}">
            {%- if block.settings.cat_1_image != blank -%}
              <img src="{{ block.settings.cat_1_image | image_url: width: 400 }}"
                   alt="{{ block.settings.cat_1_image.alt | default: block.settings.cat_1_title | escape }}"
                   width="200" height="130" loading="lazy">
            {%- else -%}
              {%- assign fc1 = collections['hair-tools'] -%}
              {%- if fc1.products.first.featured_image -%}
                <img src="{{ fc1.products.first.featured_image | image_url: width: 400 }}"
                     alt="{{ fc1.title }}" width="200" height="130" loading="lazy">
              {%- endif -%}
            {%- endif -%}
            <span>{{ block.settings.cat_1_title | default: 'Hair Tools' }}</span>
          </a>
          <a class="ks-m-cat" href="{{ block.settings.cat_2_link | default: '/collections/hair-care' }}">
            {%- if block.settings.cat_2_image != blank -%}
              <img src="{{ block.settings.cat_2_image | image_url: width: 400 }}"
                   alt="{{ block.settings.cat_2_image.alt | default: block.settings.cat_2_title | escape }}"
                   width="200" height="130" loading="lazy">
            {%- else -%}
              {%- assign fc2 = collections['hair-care'] -%}
              {%- if fc2.products.first.featured_image -%}
                <img src="{{ fc2.products.first.featured_image | image_url: width: 400 }}"
                     alt="{{ fc2.title }}" width="200" height="130" loading="lazy">
              {%- endif -%}
            {%- endif -%}
            <span>{{ block.settings.cat_2_title | default: 'Beauty Tools' }}</span>
          </a>
        </div>
      </div>

    {%- comment -%}══════════ BANNER ══════════{%- endcomment -%}
    {%- when 'banner' -%}
      {%- assign b_opa = block.settings.overlay_opacity | times: 0.01 -%}
      <div
        class="ks-m-banner"
        style="
          --bn-opa:      {{ b_opa }};
          --bn-overlay:  {{ block.settings.overlay_color }};
          --bn-head:     {{ block.settings.heading_color }};
          --bn-desc:     {{ block.settings.desc_color }};
          --bn-btn-bg:   {{ block.settings.btn_bg }};
          --bn-btn-txt:  {{ block.settings.btn_text }};
        "
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.image != blank -%}
          <img src="{{ block.settings.image | image_url: width: 800 }}"
               alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
               width="800" height="250" loading="lazy">
        {%- endif -%}
        <div class="ks-m-overlay">
          {%- if block.settings.heading != blank -%}
            <h2>{{ block.settings.heading }}</h2>
          {%- endif -%}
          {%- if block.settings.description != blank -%}
            <p>{{ block.settings.description }}</p>
          {%- endif -%}
          {%- if block.settings.btn_label != blank -%}
            <a class="ks-m-btn-light" href="{{ block.settings.btn_link }}">{{ block.settings.btn_label }}</a>
          {%- endif -%}
        </div>
      </div>

    {%- comment -%}══════════ REVIEW ══════════{%- endcomment -%}
    {%- when 'review' -%}
      <div
        class="ks-m-reviews"
        style="
          --rv-bg:     {{ block.settings.bg_color }};
          --rv-card:   {{ block.settings.card_bg }};
          --rv-ey:     {{ block.settings.eyebrow_color }};
          --rv-head:   {{ block.settings.heading_color }};
          --rv-star:   {{ block.settings.star_color }};
          --rv-text:   {{ block.settings.text_color }};
          --rv-author: {{ block.settings.author_color }};
          --rv-border: {{ block.settings.card_border }};
          --rv-dot:    {{ block.settings.dot_color }};
          --rv-dot-a:  {{ block.settings.dot_active }};
        "
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.eyebrow != blank -%}
          <span class="ks-m-eyebrow">{{ block.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if block.settings.heading != blank -%}
          <h2>{{ block.settings.heading }}</h2>
        {%- endif -%}
        <div class="ks-m-quote">
          <div class="ks-m-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          {%- if block.settings.quote != blank -%}
            <p class="ks-m-quote-text">&ldquo;{{ block.settings.quote }}&rdquo;</p>
          {%- endif -%}
          {%- if block.settings.author != blank -%}
            <p class="ks-m-quote-who">&mdash; {{ block.settings.author }}</p>
          {%- endif -%}
        </div>
        <div class="ks-m-dots">
          <span class="ks-m-dot active"></span>
          <span class="ks-m-dot"></span>
          <span class="ks-m-dot"></span>
        </div>
      </div>

    {%- endcase -%}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Mobile Homepage",
  "tag": "section",
  "disabled_on": { "groups": ["header","footer"] },
  "blocks": [

    {
      "type": "hero",
      "name": "Hero 顶部区域",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "不上传图片时显示纯色背景；上传后图片全屏铺满并叠加遮罩。" },
        { "type": "image_picker", "id": "image",       "label": "Banner 背景图片" },
        { "type": "range",       "id": "overlay_opacity", "label": "图片遮罩深度", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 45 },
        { "type": "header",      "content": "文字内容" },
        { "type": "text",        "id": "eyebrow",      "label": "小标题",   "default": "CARE BEGINS WITH STEAM" },
        { "type": "text",        "id": "heading",      "label": "主标题",   "default": "Steam. Hydrate. Transcend." },
        { "type": "textarea",    "id": "description",  "label": "描述文字", "default": "Professional facial & hair steamers for the at-home spa." },
        { "type": "text",        "id": "btn_label",    "label": "按钮文字", "default": "Shop best sellers" },
        { "type": "url",         "id": "btn_link",     "label": "按钮链接" },
        { "type": "header",      "content": "颜色（无图片时生效）" },
        { "type": "color",       "id": "bg_color",     "label": "背景色",   "default": "#EBDFCE" },
        { "type": "color",       "id": "eyebrow_color","label": "小标题颜色","default": "#8A7256" },
        { "type": "color",       "id": "heading_color","label": "主标题颜色","default": "#3A2E26" },
        { "type": "color",       "id": "desc_color",   "label": "描述文字颜色","default": "#6E5C49" },
        { "type": "color",       "id": "btn_bg",       "label": "按钮背景色","default": "#3A2E26" },
        { "type": "color",       "id": "btn_text",     "label": "按钮文字颜色","default": "#EFE6DA" }
      ]
    },

    {
      "type": "trust_bar",
      "name": "信任标语栏",
      "limit": 1,
      "settings": [
        { "type": "header",   "content": "三条标语" },
        { "type": "text",     "id": "item_1",       "label": "标语 1", "default": "Free $60+" },
        { "type": "text",     "id": "item_2",       "label": "标语 2", "default": "Prop 65 safe" },
        { "type": "text",     "id": "item_3",       "label": "标语 3", "default": "Ozone steam" },
        { "type": "header",   "content": "颜色" },
        { "type": "color",    "id": "bg_color",     "label": "背景色",    "default": "#FBF8F3" },
        { "type": "color",    "id": "border_color", "label": "分割线颜色","default": "#E6DCCD" },
        { "type": "color",    "id": "icon_color",   "label": "图标颜色",  "default": "#8A7256" },
        { "type": "color",    "id": "text_color",   "label": "文字颜色",  "default": "#6E5C49" }
      ]
    },

    {
      "type": "product_scroller",
      "name": "产品横向滑动",
      "limit": 1,
      "settings": [
        { "type": "header",     "content": "产品来源" },
        { "type": "collection", "id": "collection",       "label": "选择合集（产品从这里来）" },
        { "type": "range",      "id": "products_to_show", "label": "显示产品数量", "min": 4, "max": 50, "step": 1, "default": 50 },
        { "type": "header",     "content": "标题与链接" },
        { "type": "text",       "id": "heading",    "label": "标题",        "default": "Best sellers" },
        { "type": "text",       "id": "link_label", "label": "右侧链接文字","default": "Shop all" },
        { "type": "url",        "id": "link_url",   "label": "右侧链接地址" },
        { "type": "header",     "content": "颜色" },
        { "type": "color",      "id": "heading_color","label": "标题颜色",   "default": "#3A2E26" },
        { "type": "color",      "id": "link_color",  "label": "链接颜色",   "default": "#8A7256" },
        { "type": "color",      "id": "card_bg",     "label": "卡片背景色", "default": "#F1E9DD" },
        { "type": "color",      "id": "badge_bg",    "label": "Sale 标签色","default": "#8A5A3B" },
        { "type": "color",      "id": "name_color",  "label": "产品名称颜色","default": "#3A2E26" },
        { "type": "color",      "id": "price_color", "label": "价格颜色",   "default": "#3A2E26" }
      ]
    },

    {
      "type": "category_grid",
      "name": "分类图片网格",
      "limit": 1,
      "settings": [
        { "type": "text",        "id": "heading",      "label": "标题",       "default": "Shop by category" },
        { "type": "header",      "content": "分类 1" },
        { "type": "image_picker","id": "cat_1_image",  "label": "分类 1 图片" },
        { "type": "text",        "id": "cat_1_title",  "label": "分类 1 名称","default": "Hair Tools" },
        { "type": "url",         "id": "cat_1_link",   "label": "分类 1 链接" },
        { "type": "header",      "content": "分类 2" },
        { "type": "image_picker","id": "cat_2_image",  "label": "分类 2 图片" },
        { "type": "text",        "id": "cat_2_title",  "label": "分类 2 名称","default": "Beauty Tools" },
        { "type": "url",         "id": "cat_2_link",   "label": "分类 2 链接" },
        { "type": "header",      "content": "颜色" },
        { "type": "color",       "id": "heading_color","label": "标题颜色",   "default": "#3A2E26" },
        { "type": "color",       "id": "overlay_color","label": "图片遮罩颜色","default": "#3A2E26" },
        { "type": "range",       "id": "overlay_opacity","label": "遮罩深度", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 50 },
        { "type": "color",       "id": "label_color",  "label": "文字颜色",   "default": "#ffffff" }
      ]
    },

    {
      "type": "banner",
      "name": "全宽 Banner",
      "limit": 2,
      "settings": [
        { "type": "image_picker","id": "image",       "label": "图片" },
        { "type": "header",     "content": "文字内容" },
        { "type": "text",       "id": "heading",     "label": "标题",       "default": "2 in 1 Hair & Facial Steamer" },
        { "type": "textarea",   "id": "description", "label": "描述文字",   "default": "Deep nourishment and a radiant glow — one device." },
        { "type": "text",       "id": "btn_label",   "label": "按钮文字",   "default": "Shop now" },
        { "type": "url",        "id": "btn_link",    "label": "按钮链接" },
        { "type": "header",     "content": "颜色" },
        { "type": "color",      "id": "overlay_color","label": "遮罩颜色",  "default": "#3A2E26" },
        { "type": "range",      "id": "overlay_opacity","label": "遮罩深度","min": 0,"max": 80,"step": 5,"unit": "%","default": 40 },
        { "type": "color",      "id": "heading_color","label": "标题颜色",  "default": "#ffffff" },
        { "type": "color",      "id": "desc_color",  "label": "描述文字颜色","default": "#EFE6DA" },
        { "type": "color",      "id": "btn_bg",      "label": "按钮背景色", "default": "#FBF8F3" },
        { "type": "color",      "id": "btn_text",    "label": "按钮文字颜色","default": "#3A2E26" }
      ]
    },

    {
      "type": "review",
      "name": "客户评价",
      "settings": [
        { "type": "text",     "id": "eyebrow", "label": "小标题",   "default": "THE FEELING IS MUTUAL" },
        { "type": "text",     "id": "heading", "label": "主标题",   "default": "Hear it from our customers" },
        { "type": "textarea", "id": "quote",   "label": "评价内容", "default": "My hair feels so moisturized and my face is clearer than ever. The right amount of steam for both. Definitely recommend!" },
        { "type": "text",     "id": "author",  "label": "客户姓名", "default": "Alesha S." },
        { "type": "header",   "content": "颜色" },
        { "type": "color",    "id": "bg_color",     "label": "区块背景色",  "default": "#EBDFCE" },
        { "type": "color",    "id": "card_bg",      "label": "评价卡片背景","default": "#FBF8F3" },
        { "type": "color",    "id": "card_border",  "label": "卡片边框颜色","default": "#E0D3BF" },
        { "type": "color",    "id": "eyebrow_color","label": "小标题颜色",  "default": "#8A7256" },
        { "type": "color",    "id": "heading_color","label": "主标题颜色",  "default": "#3A2E26" },
        { "type": "color",    "id": "star_color",   "label": "星星颜色",    "default": "#C2924E" },
        { "type": "color",    "id": "text_color",   "label": "评价文字颜色","default": "#3A2E26" },
        { "type": "color",    "id": "author_color", "label": "客户名颜色",  "default": "#6E5C49" },
        { "type": "color",    "id": "dot_color",    "label": "分页点颜色",  "default": "#C9B89C" },
        { "type": "color",    "id": "dot_active",   "label": "当前分页点颜色","default": "#3A2E26" }
      ]
    }

  ],
  "presets": [
    {
      "name": "Mobile Homepage",
      "blocks": [
        { "type": "hero" },
        { "type": "trust_bar" },
        { "type": "product_scroller" },
        { "type": "category_grid" },
        { "type": "banner" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
