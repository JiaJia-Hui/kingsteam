    var now=performance.now();if(now-lastTrail<55)return;lastTrail=now;
    var m=document.createElement('div');m.className='ks-cursor-trail';
    var sz=40+Math.random()*60;
    m.style.cssText='width:'+sz+'px;height:'+sz+'px;left:'+e.clientX+'px;top:'+e.clientY+'px;animation:kstrailfade '+(1.2+Math.random()*.8)+'s ease-out forwards';
    document.body.appendChild(m);setTimeout(function(){m.remove();},2200);
