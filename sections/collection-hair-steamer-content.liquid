  document.querySelectorAll('.ks-faq-q').forEach(function(btn){
    btn.addEventListener('click',function(){
      var item=btn.closest('.ks-faq-item');
      var isOpen=item.classList.contains('open');
      document.querySelectorAll('.ks-faq-item.open').forEach(function(o){o.classList.remove('open');});
      if(!isOpen)item.classList.add('open');
    });
  });

  /* BEFORE/AFTER SLIDER */
  var slider=document.getElementById('ksBaSlider');
  var afterWrap=document.getElementById('ksBaAfterWrap');
  var divider=document.getElementById('ksBaDivider');
  function setSplit(pct){
    pct=Math.max(4,Math.min(96,pct));
    afterWrap.style.clipPath='inset(0 0 0 '+pct+'%)';
    divider.style.left=pct+'%';
  }
  setSplit(50);
  var dragging=false;
  function moveFromEvent(e){
    var r=slider.getBoundingClientRect();
    var x=(e.touches?e.touches[0].clientX:e.clientX)-r.left;
    setSplit(x/r.width*100);
  }
  if(slider){
    slider.addEventListener('pointerdown',function(e){dragging=true;moveFromEvent(e);});
    document.addEventListener('pointermove',function(e){if(dragging)moveFromEvent(e);});
    document.addEventListener('pointerup',function(){dragging=false;});
    slider.addEventListener('pointermove',function(e){if(!dragging&&e.pointerType==='mouse')moveFromEvent(e);});
  }

  /* B/A TAB DATA */
  var baData={
    dry:{k:'Dry &amp; Damaged',t:'From brittle to <em>soft &amp; supple.</em>',d:'Ozone ion steam opens the cuticle and drives moisture deep into each strand, restoring elasticity and shine to dry, over-processed hair.',m:[['+62%','Moisture retained'],['+48%','Shine increase'],['15 min','Per treatment']],b:'Before — Dry &amp; Brittle',a:'After — Soft &amp; Hydrated'},
    curly:{k:'Curly &amp; Coily',t:'From dull to <em>defined &amp; bouncy.</em>',d:'Deep steam hydration helps tight curls and coils spring back into shape — softer, springier, and far easier to detangle.',m:[['+70%','Curl definition'],['-55%','Breakage'],['15 min','Per treatment']],b:'Before — Limp curls',a:'After — Defined &amp; Bouncy'},
    frizz:{k:'Frizz-Prone',t:'From frizzy to <em>smooth &amp; sleek.</em>',d:'By sealing moisture into the cuticle, steam calms surface frizz and flyaways, leaving hair smooth without heavy products.',m:[['-64%','Frizz reduced'],['+40%','Smoothness'],['15 min','Per treatment']],b:'Before — Frizzy',a:'After — Smooth'},
    fine:{k:'Fine &amp; Flat',t:'From flat to <em>full &amp; alive.</em>',d:'Gentle ionized steam adds weightless moisture and lift to fine hair, boosting body and movement without weighing it down.',m:[['+45%','Volume'],['+38%','Softness'],['15 min','Per treatment']],b:'Before — Flat',a:'After — Full &amp; Lifted'}
  };
  var tabsEl=document.getElementById('ksBaTabs');
  var ksBaBeforeImg=document.getElementById('ksBaBeforeImg');
  var ksBaAfterImg=document.getElementById('ksBaAfterImg');
  var ksBaBeforePh=document.getElementById('ksBaBefore');
  var ksBaAfterPh=document.getElementById('ksBaAfter');
  if(tabsEl){
    tabsEl.addEventListener('click',function(e){
      var btn=e.target.closest('.ks-ba-tab');if(!btn)return;
      document.querySelectorAll('.ks-ba-tab').forEach(function(t){t.classList.remove('active');});
      btn.classList.add('active');
      var d=baData[btn.dataset.type];
      document.getElementById('ksBaKicker').innerHTML=d.k;
      document.getElementById('ksBaTitle').innerHTML=d.t;
      document.getElementById('ksBaDesc').textContent=d.d;
      document.getElementById('ksBaMetrics').innerHTML=d.m.map(function(x,i){
        return '<div style="animation-delay:'+i*.08+'s"><b>'+x[0]+'</b><span>'+x[1]+'</span></div>';
      }).join('');
      /* swap images */
      var bUrl=btn.dataset.before;var aUrl=btn.dataset.after;
      if(ksBaBeforeImg&&bUrl){ksBaBeforeImg.src=bUrl;ksBaBeforeImg.style.display='';if(ksBaBeforePh)ksBaBeforePh.style.display='none';}
      else if(ksBaBeforeImg){ksBaBeforeImg.style.display='none';if(ksBaBeforePh){ksBaBeforePh.style.display='';ksBaBeforePh.innerHTML=d.b;}}
      if(ksBaAfterImg&&aUrl){ksBaAfterImg.src=aUrl;ksBaAfterImg.style.display='';if(ksBaAfterPh)ksBaAfterPh.style.display='none';}
      else if(ksBaAfterImg){ksBaAfterImg.style.display='none';if(ksBaAfterPh){ksBaAfterPh.style.display='';ksBaAfterPh.innerHTML=d.a;}}
      setSplit(50);
    });
  }

  /* CTA STEAM */
  var box=document.getElementById('ksCtaSteam');
  if(box){setInterval(function(){
    var s=document.createElement('div');s.className='ks-stm';
    var sz=14+Math.random()*22;s.style.width=s.style.height=sz+'px';
    s.style.left=(Math.random()*100)+'%';s.style.setProperty('--dx',(Math.random()*60-30)+'px');
    var d=3+Math.random()*2;s.style.animation='ks-srise '+d+'s ease-out forwards';
    box.appendChild(s);setTimeout(function(){s.remove();},d*1000);
  },320);}

  /* SCROLL MIST + BACK TO TOP */
  var topBtn=document.getElementById('ksTopBtn');
  window.addEventListener('scroll',function(){
    var p=Math.min(scrollY/innerHeight,1);
    if(mistBg)mistBg.style.opacity=(0.6+p*.4).toFixed(2);
    if(topBtn){scrollY>320?topBtn.classList.add('visible'):topBtn.classList.remove('visible');}
  });
  if(topBtn){topBtn.addEventListener('click',function(){window.scrollTo({top:0,behavior:'smooth'});});}
})();
</script>

