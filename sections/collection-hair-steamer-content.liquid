  document.addEventListener('pointermove',function(e){px=e.clientX;py=e.clientY;});
  (function follow(){mcx+=(px-mcx)*.18;mcy+=(py-mcy)*.18;mc.style.transform='translate('+mcx+'px,'+mcy+'px)';requestAnimationFrame(follow);})();
  document.querySelectorAll('a,button,.ks-pillar,.ks-benefits li,.ks-ba-slider').forEach(function(el){
