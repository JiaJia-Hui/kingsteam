<script>
(function(){
  var mc=document.getElementById('ksCursor');
  if(!mc)return;
  var mcx=innerWidth/2,mcy=innerHeight/2,px=mcx,py=mcy;
  document.addEventListener('pointermove',function(e){px=e.clientX;py=e.clientY;});
  (function follow(){mcx+=(px-mcx)*.18;mcy+=(py-mcy)*.18;mc.style.transform='translate('+mcx+'px,'+mcy+'px)';requestAnimationFrame(follow);})();
  document.querySelectorAll('a,button,.ks-pillar,.ks-benefits li').forEach(function(el){el.addEventListener('pointerenter',function(){mc.classList.add('big');});el.addEventListener('pointerleave',function(){mc.classList.remove('big');});});
  document.addEventListener('pointerleave',function(){mc.style.opacity='0';});
  document.addEventListener('pointerenter',function(){mc.style.opacity='1';});

  var lastTrail=0;
  document.addEventListener('pointermove',function(e){
    var now=performance.now();if(now-lastTrail<60)return;lastTrail=now;
    var m=document.createElement('div');m.className='ks-cursor-trail';
    var sz=40+Math.random()*60;
    m.style.cssText='width:'+sz+'px;height:'+sz+'px;left:'+e.clientX+'px;top:'+e.clientY+'px;animation:kstrailfade '+(1.2+Math.random()*.8)+'s ease-out forwards';
    document.body.appendChild(m);setTimeout(function(){m.remove();},2200);
  });

  var mistBg=document.querySelector('.ks-mist-bg'),tx=0,ty=0,cx=0,cy=0;
  document.addEventListener('pointermove',function(e){tx=(e.clientX/innerWidth-.5);ty=(e.clientY/innerHeight-.5);});
  (function drift(){cx+=(tx-cx)*.05;cy+=(ty-cy)*.05;if(mistBg)mistBg.style.transform='translate('+cx*40+'px,'+cy*40+'px)';requestAnimationFrame(drift);})();

  var io=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('ks-in');io.unobserve(e.target);}});},{threshold:.15});
  document.querySelectorAll('.ks-benefits li,.ks-pillar,.ks-row,.ks-step,.ks-faq-item').forEach(function(el,i){el.style.transitionDelay=(i%4*.08)+'s';io.observe(el);});

  document.querySelectorAll('.ks-faq-q').forEach(function(btn){btn.addEventListener('click',function(){var item=btn.closest('.ks-faq-item');var isOpen=item.classList.contains('open');document.querySelectorAll('.ks-faq-item.open').forEach(function(o){o.classList.remove('open');});if(!isOpen)item.classList.add('open');});});

  var box=document.getElementById('ksCtaSteam');
  if(box){setInterval(function(){var s=document.createElement('div');s.className='ks-stm';var sz=14+Math.random()*22;s.style.width=s.style.height=sz+'px';s.style.left=(Math.random()*100)+'%';s.style.setProperty('--dx',(Math.random()*50-25)+'px');var d=3+Math.random()*2;s.style.animation='ks-srise '+d+'s ease-out forwards';box.appendChild(s);setTimeout(function(){s.remove();},d*1000);},340);}

  window.addEventListener('scroll',function(){var p=Math.min(scrollY/innerHeight,1);if(mistBg)mistBg.style.opacity=(0.6+p*.4).toFixed(2);});
})();
</script>

