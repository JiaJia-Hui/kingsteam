{{ 'kingsteam-home.css' | asset_url | stylesheet_tag }}
{{ 'ks-home-accessory-hover.css' | asset_url | stylesheet_tag }}

{% if section.settings.products != blank %}
  <div class="ks-home-refresh">
    <section id="home-accessories" class="accessories" aria-labelledby="accessories-heading-{{ section.id }}">
      <div class="shell">
        <div class="accessories-heading">
          <h2 id="accessories-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
          {% if section.settings.view_all != blank %}
            <a class="text-link" href="{{ section.settings.view_all }}" aria-label="View all {{ section.settings.heading | escape }}">
              View all <span aria-hidden="true">→</span>
            </a>
          {% endif %}
        </div>
        <div class="accessory-grid">
          {% for product in section.settings.products %}
            <article class="accessory-card">
              <a href="{{ product.url }}">
                {% if product.featured_image %}
                  {%- liquid
                    assign hover_image = product.images[1]
                    assign hover_url = blank
                    if hover_image != blank and hover_image.id != product.featured_image.id
                      assign hover_url = hover_image | image_url: width: 800
                    endif
                  -%}
                  <div class="accessory-card__media">
                    {{ product.featured_image | image_url: width: 800 | image_tag:
                      widths: '180, 260, 400, 600, 800',
                      sizes: '(max-width: 650px) 50vw, 25vw',
                      loading: 'lazy',
                      alt: '',
                      class: 'accessory-card__primary'
                    }}
                    {% if hover_url != blank %}
                      <picture class="accessory-card__alternate" aria-hidden="true">
                        <source media="(hover: hover) and (pointer: fine)" srcset="{{ hover_url | escape }}">
                        <img src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs="
                          width="800" height="800" loading="lazy" decoding="async" alt="">
                      </picture>
                    {% endif %}
                  </div>
                {% endif %}
                <h3>{{ product.title | escape }}</h3>
              </a>
              <p class="accessory-price">
                <span>
                  {%- assign display_price = product.price | money -%}
                  {%- if product.price_varies -%}
                    {{ 'products.product.from_text_html' | t: price: display_price }}
                  {%- else -%}
                    {{ display_price }}
                  {%- endif -%}
                </span>
                {% if product.compare_at_price > product.price %}
                  <s>{{ product.compare_at_price | money }}</s>
                {% endif %}
              </p>
              {% unless product.available %}
                <p class="accessory-status">{{ 'products.product.sold_out' | t }}</p>
              {% endunless %}
            </article>
          {% endfor %}
        </div>
      </div>
    </section>
  </div>
{% endif %}

{% schema %}
{
  "name": "Home & Accessories",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Home & Accessories" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 12 },
    { "type": "url", "id": "view_all", "label": "View all link" }
  ],
  "presets": [{ "name": "Home & Accessories" }]
}
{% endschema %}
