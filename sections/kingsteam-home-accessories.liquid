{{ 'kingsteam-home.css' | asset_url | stylesheet_tag }}
{{ 'ks-home-accessory-hover.css' | asset_url | stylesheet_tag }}
<script type="module" src="{{ 'ks-home-card-options.js' | asset_url }}"></script>

{% if section.settings.products != blank %}
  {%- liquid
    assign section_anchor = 'home-accessories'
    if section.settings.layout == 'best_sellers'
      assign section_anchor = 'best-sellers'
    endif
  -%}
  <div class="ks-home-refresh">
    <section id="{{ section_anchor }}" class="accessories{% if section.settings.layout == 'best_sellers' %} accessories--best-sellers{% endif %}" aria-labelledby="accessories-heading-{{ section.id }}">
      <div class="shell">
        <div class="accessories-heading">
          <h2 id="accessories-heading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
          {% if section.settings.view_all != blank %}
            <a class="text-link" href="{{ section.settings.view_all }}" aria-label="{% if section.settings.layout == 'best_sellers' %}View all products{% else %}View all {{ section.settings.heading | escape }}{% endif %}">
              View all <span aria-hidden="true">→</span>
            </a>
          {% endif %}
        </div>
        <div class="accessory-grid">
          {% for product in section.settings.products %}
            <article class="accessory-card">
              <a href="{{ product.url }}">
                {% if product.featured_image %}
                  {%- liquid
                    assign hover_image = product.images[1]
                    assign hover_url = blank
                    if hover_image != blank and hover_image.id != product.featured_image.id
                      assign hover_url = hover_image | image_url: width: 800
                    endif
                  -%}
                  <div class="accessory-card__media">
                    {{ product.featured_image | image_url: width: 800 | image_tag:
                      widths: '180, 260, 400, 600, 800',
                      sizes: '(max-width: 650px) 50vw, 25vw',
                      loading: 'lazy',
                      alt: '',
                      class: 'accessory-card__primary'
                    }}
                    {% if hover_url != blank %}
                      <picture class="accessory-card__alternate" aria-hidden="true">
                        <source media="(hover: hover) and (pointer: fine)" srcset="{{ hover_url | escape }}">
                        <img src="data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs="
                          width="800" height="800" loading="lazy" decoding="async" alt="">
                      </picture>
                    {% endif %}
                  </div>
                {% endif %}
                <h3>{{ product.title | escape }}</h3>
              </a>
              <p class="accessory-price">
                <span data-card-price>
                  {%- assign display_price = product.price | money -%}
                  {%- if product.price_varies -%}
                    {{ 'products.product.from_text_html' | t: price: display_price }}
                  {%- else -%}
                    {{ display_price }}
                  {%- endif -%}
                </span>
                <s data-card-compare-price{% unless product.compare_at_price > product.price %} hidden{% endunless %}>{% if product.compare_at_price > product.price %}{{ product.compare_at_price | money }}{% endif %}</s>
              </p>
              <home-card-options class="accessory-card__purchase">
                {%- liquid
                  assign card_variant = product.first_available_variant
                  assign needs_product_page = product.requires_selling_plan
                  assign pictured_variant = blank
                  assign featured_image_id = product.featured_image.id
                  for variant in product.variants
                    if variant.available and variant.quantity_rule.min > 1
                      assign needs_product_page = true
                      break
                    endif
                    if variant.available and pictured_variant == blank and featured_image_id != blank and variant.featured_image.id == featured_image_id
                      assign pictured_variant = variant
                    endif
                  endfor
                  if pictured_variant != blank
                    assign card_variant = pictured_variant
                  endif
                  assign form_id = 'HomeCardForm-' | append: section.id | append: '-' | append: product.id
                  assign add_to_cart = 'products.product.add_to_cart' | t
                -%}
                {% unless product.has_only_default_variant or needs_product_page %}
                  {% assign displayed_variant = card_variant | default: product.selected_or_first_available_variant %}
                  {% render 'ks-home-card-swatches', product: product, active_variant: displayed_variant, form_id: form_id %}
                {% endunless %}
                {% if card_variant == blank %}
                  <button class="button primary accessory-card__button" type="button" disabled>
                    {{ 'products.product.sold_out' | t }}
                  </button>
                {% elsif needs_product_page %}
                  <a class="button primary accessory-card__button" href="{{ product.url }}">
                    {{ 'products.product.select_options' | t }}
                  </a>
                {% else %}
                  <product-form class="m-product-form" data-product-id="{{ product.id }}">
                    {% form 'product', product, id: form_id, class: 'product-card-form' %}
                      {% if product.has_only_default_variant %}
                        <input type="hidden" name="id" value="{{ card_variant.id }}">
                      {% else %}
                        <label class="accessory-card__variant-fallback" data-card-variant-fallback>
                          {{ product.options | join: ' / ' | escape }}
                          <select class="accessory-card__variant" name="id">
                            {% for variant in product.variants %}
                              <option value="{{ variant.id }}"{% if variant.id == card_variant.id %} selected{% endif %}{% unless variant.available %} disabled{% endunless %}>
                                {{ variant.title | escape }}
                                {%- if product.price_varies %} — {{ variant.price | money }}{% endif -%}
                                {%- unless variant.available %} — {{ 'products.product.sold_out' | t }}{% endunless -%}
                              </option>
                            {% endfor %}
                          </select>
                        </label>
                      {% endif %}
                      <button class="button primary accessory-card__button m-spinner-button" type="submit" name="add" aria-label="{{ add_to_cart | escape }} · {{ product.title | escape }}">
                        <span class="m-add-to-cart--text">{{ add_to_cart }}</span>
                        <span class="m-spinner-icon" aria-hidden="true">
                          <svg class="animate-spin m-svg-icon--medium" viewBox="0 0 24 24" fill="none" focusable="false">
                            <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" opacity=".25"/>
                            <path d="M22 12A10 10 0 0 0 12 2" stroke="currentColor" stroke-width="4"/>
                          </svg>
                        </span>
                      </button>
                      <div class="m-product-form-message" aria-live="polite"></div>
                    {% endform %}
                  </product-form>
                {% endif %}
              </home-card-options>
            </article>
          {% endfor %}
        </div>
      </div>
    </section>
  </div>
{% endif %}

{% schema %}
{
  "name": "Homepage product grid",
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Home & Accessories" },
    {
      "type": "select", "id": "layout", "label": "Layout", "default": "accessories",
      "options": [
        { "value": "accessories", "label": "Home & Accessories" },
        { "value": "best_sellers", "label": "Best Sellers" }
      ]
    },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 12 },
    { "type": "url", "id": "view_all", "label": "View all link" }
  ],
  "presets": [{ "name": "Home & Accessories" }]
}
{% endschema %}
